(Queries
  (Query*
    (Query
      (SimpleStatement
        (ReplicationStatement
          (ChangeSource
            CHANGE
            (ChangeReplicationSource REPLICATION SOURCE)
            TO
            (SourceDefinitions
              (SourceDefinition
                (ChangeReplicationSourceSSLKey SOURCE_SSL_KEY)
                EQUAL
                (TextStringNoLinebreak
                  (TextStringLiteral SingleQuotedText)))
              ((COMMA SourceDefinition)*
                COMMA
                (SourceDefinition
                  (ChangeReplicationSourceSSLCLRpath SOURCE_SSL_CRLPATH)
                  EQUAL
                  (TextStringNoLinebreak
                    (TextStringLiteral SingleQuotedText))))))))
      SEMICOLON)))
