(Queries
  (Query*
    (Query
      (SimpleStatement
        (ResourceGroupManagement
          (CreateResourceGroup
            CREATE
            RESOURCE
            GROUP
            (Identifier
              (PureIdentifier
                (UnquotedIdentifier OrdinaryIdentifier)))
            TYPE
            (Equal EQUAL)
            USER
            (ResourceGroupVcpuList
              VCPU
              (Equal EQUAL)
              (VcpuNumOrRange IntegerLiteral MINUS IntegerLiteral))
            (ResourceGroupPriority
              THREAD_PRIORITY
              (Equal EQUAL)
              IntegerLiteral)
            (ResourceGroupEnableDisable ENABLE))))
      SEMICOLON)
    (Query
      (SimpleStatement
        (ResourceGroupManagement
          (AlterResourceGroup
            ALTER
            RESOURCE
            GROUP
            (ResourceGroupRef
              (Identifier
                (PureIdentifier
                  (UnquotedIdentifier OrdinaryIdentifier))))
            (ResourceGroupEnableDisable DISABLE)
