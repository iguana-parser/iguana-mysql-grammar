(Queries
  (Query*
    (Query
      (SimpleStatement
        (ReplicationStatement
          (ChangeSource
            CHANGE
            (ChangeReplicationSource MASTER)
            TO
            (SourceDefinitions
              (SourceDefinition
                (ChangeReplicationSourceCompressionAlgorithm MASTER_COMPRESSION_ALGORITHM)
                EQUAL
                (TextStringLiteral SingleQuotedText))
              ((COMMA SourceDefinition)*
                COMMA
                (SourceDefinition
                  (ChangeReplicationSourceGetSourcePublicKey GET_MASTER_PUBLIC_KEY)
                  EQUAL
                  (UlongNumber IntegerLiteral)))))))
      SEMICOLON)
    (Query
      (SimpleStatement
        (ReplicationStatement
          (ChangeSource
            CHANGE
            (ChangeReplicationSource REPLICATION SOURCE)
            TO
            (SourceDefinitions
              (SourceDefinition
                (ChangeReplicationSourceCompressionAlgorithm SOURCE_COMPRESSION_ALGORITHM)
                EQUAL
                (TextStringLiteral SingleQuotedText))
              ((COMMA SourceDefinition)*
                COMMA
                (SourceDefinition
                  (ChangeReplicationSourceGetSourcePublicKey GET_SOURCE_PUBLIC_KEY)
                  EQUAL
                  (UlongNumber IntegerLiteral)))))))
      SEMICOLON)))
