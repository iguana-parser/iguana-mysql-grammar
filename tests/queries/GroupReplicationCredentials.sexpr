(Queries
  (Query*
    (Query
      (SimpleStatement
        (ReplicationStatement
          (GroupReplication
            START
            GROUP_REPLICATION
            (GroupReplicationStartOptions
              (GroupReplicationStartOption
                (GroupReplicationUser
                  USER
                  EQUAL
                  (TextStringNoLinebreak
                    (TextStringLiteral SingleQuotedText))))
              ((COMMA GroupReplicationStartOption)*
                COMMA
                (GroupReplicationStartOption
                  (GroupReplicationPassword
                    PASSWORD
                    EQUAL
                    (TextStringNoLinebreak
                      (TextStringLiteral SingleQuotedText))))
                COMMA
                (GroupReplicationStartOption
                  (GroupReplicationPluginAuth
                    DEFAULT_AUTH
                    EQUAL
                    (TextStringNoLinebreak
                      (TextStringLiteral SingleQuotedText)))))))))
      SEMICOLON)
    (Query
      (SimpleStatement
        (ReplicationStatement
          (GroupReplication
            START
            GROUP_REPLICATION
            (GroupReplicationStartOptions
              (GroupReplicationStartOption
                (GroupReplicationPluginAuth
                  DEFAULT_AUTH
                  EQUAL
