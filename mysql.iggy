  | LOCAL
  | SESSION

JsonAttribute
  = TextStringLiteral

FinalQuery
  = SimpleStatement
  | BeginWork

FlushTableList
  = QualifiedIdentifier (COMMA QualifiedIdentifier)*

GroupAlterStatement1
  = AlterTable #Option1
  | AlterDatabase #Option2
  | PROCEDURE ProcedureRef RoutineAlterOptions? #Option3
  | FUNCTION FunctionRef RoutineAlterOptions? #Option4
  | AlterView #Option5
  | AlterEvent #Option6
  | AlterTablespace #Option7
  | AlterUndoTablespace #Option8
  | AlterLogfileGroup #Option9
  | AlterServer #Option10
  | AlterInstanceStatement #Option11

GroupAlterEvent1
  = ENABLE #Option1
  | DISABLE (ON Replica)? #Option2

GroupAlterPartition1
  = PartitionDefinitions #Option1
  | PARTITIONS RealUlongNumber #Option2

GroupAlterListItem1
  = Identifier FieldDefinition CheckOrReferences? Place? #Option1
  | OPEN_PAR TableElementList CLOSE_PAR #Option2

GroupAlterListItem2
  = COLUMN? ColumnInternalRef Restrict? #Option1
  | FOREIGN KEY ColumnInternalRef #Option2
  | PRIMARY KEY #Option3
  | KeyOrIndex IndexRef #Option4
  | CHECK Identifier #Option5
  | CONSTRAINT Identifier #Option6

GroupAlterListItem3
  = SET DEFAULT (ExprWithParentheses | SignedLiteralOrNull) #Option1
  | DROP DEFAULT #Option2
  | SET Visibility #Option3

GroupAlterTablespace1
  = (ADD | DROP) DATAFILE TextLiteral AlterTablespaceOptions? #Option1
  | RENAME TO Identifier #Option2
  | AlterTablespaceOptions #Option3

GroupAlterInstanceStatement1
  = NO ROLLBACK ON ERROR #Option1
  | FOR CHANNEL Identifier (NO ROLLBACK ON ERROR)? #Option2

GroupAlterInstanceStatement2
  = RELOAD TLS GroupAlterInstanceStatement1 #Option1
  | (ENABLE | DISABLE) Identifier Identifier #Option2
  | RELOAD KEYRING #Option3

GroupCreateTable1
  = (OPEN_PAR TableElementList CLOSE_PAR)? CreateTableOptionsEtc? #Option1
  | LIKE TableRef #Option2
  | OPEN_PAR LIKE TableRef CLOSE_PAR #Option3

GroupCreateIndex1
  = UNIQUE? KW_INDEX IndexName IndexTypeClause? CreateIndexTarget IndexOption* #Option1
  | FULLTEXT KW_INDEX IndexName CreateIndexTarget FulltextIndexOption* #Option2
  | SPATIAL KW_INDEX IndexName CreateIndexTarget SpatialIndexOption* #Option3

GroupCreateEvent1
  = ENABLE #Option1
  | DISABLE (ON Replica)? #Option2

GroupDeleteStatement1
  = TableAliasRefList USING TableReferenceList WhereClause? #Option1
  | TableRef (TableAlias)? PartitionDelete? WhereClause? OrderClause? SimpleLimitClause? #Option2

GroupDeleteStatement2
  = FROM GroupDeleteStatement1 #Option1
  | TableAliasRefList FROM TableReferenceList WhereClause? #Option2

GroupHandlerStatement1
  = CLOSE #Option1
  | READ HandlerReadOrScan WhereClause? LimitClause? #Option2

GroupHandlerStatement2
  = TableRef OPEN TableAlias? #Option1
  | Identifier GroupHandlerStatement1 #Option2

GroupHandlerReadOrScan1
  = (FIRST | NEXT | PREV | LAST) #Option1
  | (EQUAL | LESS_THAN | GREATER_THAN | LESS_OR_EQUAL | GREATER_OR_EQUAL) OPEN_PAR Values CLOSE_PAR #Option2

GroupInsertStatement1
  = InsertFromConstructor ValuesReference? #Option1
  | SET UpdateList ValuesReference? #Option2
  | InsertQueryExpression #Option3

GroupReplaceStatement1
  = InsertFromConstructor #Option1
  | SET UpdateList #Option2
  | InsertQueryExpression #Option3

GroupQueryExpressionBody1
  = UNION #Option1
  | (EXCEPT | INTERSECT) #Option2

GroupIntoClause1
  = OUTFILE TextStringLiteral CharsetClause? FieldsClause? LinesClause? #Option1
  | DUMPFILE TextStringLiteral #Option2
  | (TextOrIdentifier | UserVariable) (COMMA (TextOrIdentifier | UserVariable))* #Option3

GroupWindowFrameExclusion1
  = CURRENT ROW #Option1
  | GROUP #Option2
  | TIES #Option3
  | NO OTHERS #Option4

GroupTableReference1
  = TableFactor #Option1
  | OPEN_CURLY (Identifier | OJ) EscapedTableReference CLOSE_CURLY #Option2

GroupJoinedTable1
  = ON Expression #Option1
  | USING IdentifierListWithParentheses #Option2

GroupJoinedTable2
  = ON Expression #Option1
  | USING IdentifierListWithParentheses #Option2

GroupIndexHintClause1
  = JOIN #Option1
  | ORDER BY #Option2
  | GROUP BY #Option3

GroupXaStatement1
  = (START | BEGIN) Xid ((JOIN | RESUME))? #Option1
  | END Xid (SUSPEND (FOR MIGRATE)?)? #Option2
  | PREPARE Xid #Option3
  | COMMIT Xid (ONE PHASE)? #Option4
  | ROLLBACK Xid #Option5
  | RECOVER XaConvert? #Option6

GroupPurgeOptions1
  = TO TextLiteral #Option1
  | BEFORE Expression #Option2

GroupReplicaUntil1
  = SourceFileDef #Option1
  | (SQL_BEFORE_GTIDS | SQL_AFTER_GTIDS) EQUAL TextString #Option2
  | SQL_AFTER_MTS_GAPS #Option3

GroupGroupReplication1
  = START GroupReplicationStartOptions? #Option1
  | STOP #Option2

GroupCloneStatement1
  = LOCAL DATA DIRECTORY Equal? TextStringLiteral #Option1
  | INSTANCE FROM User COLON UlongNumber IDENTIFIED BY TextStringLiteral DataDirSSL? #Option2

GroupAlterUser1
  = REPLACE TextStringLiteral RetainCurrentPassword? #Option1
  | RetainCurrentPassword? #Option2

GroupAlterUser2
  = RetainCurrentPassword? #Option1
  | REPLACE TextStringLiteral RetainCurrentPassword? #Option2

GroupAlterUser3
  = REPLACE TextStringLiteral RetainCurrentPassword? #Option1
  | RetainCurrentPassword? #Option2

GroupAlterUser4
  = IdentifiedByPassword GroupAlterUser1 #Option1
  | IdentifiedByRandomPassword GroupAlterUser2 #Option2
  | IdentifiedWithPlugin #Option3
  | IdentifiedWithPluginAsAuth RetainCurrentPassword? #Option4
  | IdentifiedWithPluginByPassword GroupAlterUser3 #Option5
  | IdentifiedWithPluginByRandomPassword RetainCurrentPassword? #Option6
  | DiscardOldPassword? #Option7
  | ADD Factor Identification (ADD Factor Identification)? #Option8
  | MODIFY Factor Identification (MODIFY Factor Identification)? #Option9
  | DROP Factor (DROP Factor)? #Option10

GroupOldAlterUser1
  = TextString REPLACE TextString RetainCurrentPassword? #Option1
  | TextString RetainCurrentPassword? #Option2
  | RANDOM PASSWORD (REPLACE TextString)? RetainCurrentPassword? #Option3

GroupOldAlterUser2
  = BY TextString REPLACE TextString RetainCurrentPassword? #Option1
  | AS TextStringHash RetainCurrentPassword? #Option2
  | BY TextString RetainCurrentPassword? #Option3
  | BY RANDOM PASSWORD RetainCurrentPassword? #Option4

GroupUserFunction1
  = USER Parentheses #Option1
  | USER_CALL_OPEN CLOSE_PAR #Option2

GroupRequireClause1
  = RequireList #Option1
  | (SSL | X509 | NONE) #Option2

GroupConnectOptions1
  = MAX_QUERIES_PER_HOUR UlongNumber #Option1
  | MAX_UPDATES_PER_HOUR UlongNumber #Option2
  | MAX_CONNECTIONS_PER_HOUR UlongNumber #Option3
  | MAX_USER_CONNECTIONS UlongNumber #Option4

GroupAccountLockPasswordExpireOptions1
  = INTERVAL RealUlongNumber DAY #Option1
  | NEVER #Option2
  | DEFAULT #Option3

GroupAccountLockPasswordExpireOptions2
  = RealUlongNumber DAY #Option1
  | DEFAULT #Option2

GroupAccountLockPasswordExpireOptions3
  = EXPIRE GroupAccountLockPasswordExpireOptions1? #Option1
  | HISTORY (RealUlongNumber | DEFAULT) #Option2
  | REUSE INTERVAL GroupAccountLockPasswordExpireOptions2 #Option3
  | REQUIRE CURRENT ((DEFAULT | OPTIONAL))? #Option4

GroupGrantStatement1
  = RoleOrPrivilegesList #Option1
  | ALL PRIVILEGES? #Option2

GroupGrantStatement2
  = RoleOrPrivilegesList TO UserList (WITH ADMIN OPTION)? #Option1
  | GroupGrantStatement1 ON AclType? GrantIdentifier TO GrantTargetList GrantOptions? GrantAs? #Option2
  | PROXY ON User TO GrantTargetList (WITH GRANT OPTION)? #Option3

GroupWithRoles1
  = RoleList #Option1
  | ALL ExceptRoleList? #Option2
  | NONE #Option3
  | DEFAULT #Option4

GroupRevokeStatement1
  = ON AclType? GrantIdentifier #Option1
  | COMMA GRANT OPTION #Option2

GroupRevokeStatement2
  = RoleOrPrivilegesList FROM UserList #Option1
  | RoleOrPrivilegesList ON AclType? GrantIdentifier FROM UserList #Option2
  | ALL PRIVILEGES? GroupRevokeStatement1 FROM UserList #Option3
  | PROXY ON User FROM UserList #Option4

GroupRoleOrPrivilege1
  = AtTextSuffix #Option1
  | AT_SIGN TextOrIdentifier #Option2

GroupRoleOrPrivilege2
  = RoleIdentifierOrText ColumnInternalRefList? #Option1
  | RoleIdentifierOrText GroupRoleOrPrivilege1 #Option2

GroupRoleOrPrivilege3
  = TEMPORARY TABLES #Option1
  | (ROUTINE | TABLESPACE | USER | VIEW) #Option2

GroupUninstallStatement1
  = PLUGIN PluginRef #Option1
  | COMPONENT ComponentRef (COMMA ComponentRef)* #Option2

GroupInstallStatement1
  = PLUGIN Identifier SONAME TextStringLiteral #Option1
  | COMPONENT TextStringLiteralList InstallSetValueList? #Option2

GroupIsolationLevel1
  = REPEATABLE READ #Option1
  | READ (COMMITTED | UNCOMMITTED) #Option2
  | SERIALIZABLE #Option3

GroupOptionValueNoOptionType1
  = Equal Expression #Option1
  | CharsetName Collate? #Option2
  | DEFAULT #Option3

GroupShowReplicasStatement1
  = Replica HOSTS #Option1
  | REPLICAS #Option2

GroupOtherAdministrativeStatement1
  = FlushTables #Option1
  | FlushOption (COMMA FlushOption)* #Option2

GroupFlushTables1
  = WITH READ LOCK #Option1
  | FlushTableList FlushTablesOptions? #Option2

GroupSumExpr1
  = BIT_AND_CALL_OPEN InSumExpr CLOSE_PAR WindowingClause? #Option1
  | BIT_OR_CALL_OPEN InSumExpr CLOSE_PAR WindowingClause? #Option2
  | BIT_XOR_CALL_OPEN InSumExpr CLOSE_PAR WindowingClause? #Option3

GroupSumExpr2
  = ALL? MULT #Option1
  | InSumExpr #Option2
