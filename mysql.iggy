SUBSTRING_CALL_OPEN = ([mM] [iI] [dD] "(" | [sS] [uU] [bB] [sS] [tT] [rR] "(" | [sS] [uU] [bB] [sS] [tT] [rR] [iI] [nN] [gG] "(")

