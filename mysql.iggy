  | MAX_CALL_OPEN DISTINCT? InSumExpr CLOSE_PAR WindowingClause? #Option2

GroupSumExpr4
  = STD_CALL_OPEN InSumExpr CLOSE_PAR WindowingClause? #Option1
  | VARIANCE_CALL_OPEN InSumExpr CLOSE_PAR WindowingClause? #Option2
  | STDDEV_SAMP_CALL_OPEN InSumExpr CLOSE_PAR WindowingClause? #Option3
  | VAR_SAMP_CALL_OPEN InSumExpr CLOSE_PAR WindowingClause? #Option4
  | SUM_CALL_OPEN InSumExpr CLOSE_PAR WindowingClause? #Option5

GroupRuntimeFunctionCall1
  = Expression #Option1
  | INTERVAL Expression Interval #Option2

GroupRuntimeFunctionCall2
  = Expression #Option1
  | INTERVAL Expression Interval #Option2

GroupRuntimeFunctionCall3
  = ADDDATE_CALL_OPEN Expression COMMA GroupRuntimeFunctionCall1 CLOSE_PAR #Option1
  | SUBDATE_CALL_OPEN Expression COMMA GroupRuntimeFunctionCall2 CLOSE_PAR #Option2

GroupRuntimeFunctionCall4
  = DATE_ADD_CALL_OPEN Expression COMMA INTERVAL Expression Interval CLOSE_PAR #Option1
  | DATE_SUB_CALL_OPEN Expression COMMA INTERVAL Expression Interval CLOSE_PAR #Option2

GroupRuntimeFunctionCall5
  = NOW TimeFunctionParameters? #Option1
  | NOW_CALL_OPEN FractionalPrecision? CLOSE_PAR #Option2

GroupRuntimeFunctionCall6
  = (AS CHAR WsNumCodepoints)? #Option1
  | AS BINARY WsNumCodepoints #Option2
  | COMMA UlongNumber COMMA UlongNumber COMMA UlongNumber #Option3

GroupWeightStringLevels1
  = RealUlongNumber MINUS RealUlongNumber #Option1
  | WeightStringLevelListItem (COMMA WeightStringLevelListItem)* #Option2

GroupWeightStringLevelListItem1
  = (ASC | DESC) REVERSE? #Option1
  | REVERSE #Option2

GroupTrimFunction1
  = Expression (FROM Expression)? #Option1
  | LEADING Expression? FROM Expression #Option2
  | TRAILING Expression? FROM Expression #Option3
  | BOTH Expression? FROM Expression #Option4

GroupSubstringFunction1
  = COMMA Expression (COMMA Expression)? #Option1
  | FROM Expression (FOR Expression)? #Option2

GroupLvalueVariable1
  = Identifier DotIdentifier? #Option1
  | LValueIdentifier DotIdentifier? #Option2

GroupIfBody1
  = ELSEIF IfBody #Option1
  | ELSE CompoundStatementList #Option2

GroupGetDiagnosticsStatement1
  = StatementInformationItem (COMMA StatementInformationItem)* #Option1
  | CONDITION SignalAllowedExpr ConditionInformationItem (COMMA ConditionInformationItem)* #Option2

GroupTableConstraintDef1
  = PRIMARY KEY #Option1
  | UNIQUE KeyOrIndex? #Option2

GroupTableConstraintDef2
  = GroupTableConstraintDef1 IndexNameAndType? KeyListWithExpression IndexOption* #Option1
  | FOREIGN KEY IndexName? KeyList References #Option2
  | CheckConstraint ConstraintEnforcement? #Option3

GroupFieldDefinition1
  = ColumnAttribute* #Option1
  | Collate? (GENERATED ALWAYS)? AS ExprWithParentheses ((VIRTUAL | STORED))? ColumnAttribute* #Option2

GroupColumnAttribute1
  = ON UPDATE NOW TimeFunctionParameters? #Option1
  | ON UPDATE NOW_CALL_OPEN FractionalPrecision? CLOSE_PAR #Option2

GroupNow1
  = NOW FunctionDatetimePrecision #Option1
  | NOW_CALL_OPEN CLOSE_PAR #Option2
  | NOW_CALL_OPEN IntegerLiteral CLOSE_PAR #Option3

GroupReferences1
  = ON UPDATE DeleteOption (ON DELETE DeleteOption)? #Option1
  | ON DELETE DeleteOption (ON UPDATE DeleteOption)? #Option2

GroupDataType1
  = REAL #Option1
  | DOUBLE PRECISION? #Option2

GroupDataType2
  = CHAR VARYING #Option1
  | VARCHAR #Option2

GroupDataType3
  = NATIONAL VARCHAR #Option1
  | NVARCHAR #Option2
  | NCHAR VARCHAR #Option3
  | NATIONAL CHAR VARYING #Option4
  | NCHAR VARYING #Option5

GroupDataType4
  = CHAR VARYING #Option1
  | VARCHAR #Option2

GroupPartitionTypeDef1
  = OPEN_PAR BitExpression CLOSE_PAR #Option1
  | COLUMNS OPEN_PAR IdentifierList? CLOSE_PAR #Option2

GroupSubPartitions1
  = HASH OPEN_PAR BitExpression CLOSE_PAR #Option1
  | KEY PartitionKeyAlgorithm? IdentifierListWithParentheses #Option2

GroupPartitionDefinition1
  = VALUES LESS THAN (PartitionValueItemListParen | MAXVALUE) #Option1
  | VALUES IN PartitionValuesIn #Option2

GroupPersistedVariableIdentifier1
  = QualifiedIdentifier #Option1
  | DEFAULT DotIdentifier #Option2

GroupTableRefWithWildcard1
  = DOT MULT #Option1
  | DotIdentifier (DOT MULT)? #Option2

// Expressions are deliberately recursive, as in the Java Iggy grammar.
// > orders recursive alternatives; left/right select associativity.
// The operand views below retain Oracle's operand categories in the unchanged
// rules. LIKE uses an exclusion-based SimpleExpression pattern operand,
// matching MySQL's parse-time restriction; parentheses admit any expression.
Expression
  = ExpressionColumnRef JsonOperator?                                          #Column
  | RuntimeFunctionCall
  | FunctionCall
  | Literal                                                                    #Literal
  | PARAM_MARKER
  | RvalueSystemOrUserVariable
  | SumExpr
  | GroupingOperation
  | WindowFunctionCall
  | OPEN_PAR Expression!Subquery CLOSE_PAR                                     #Parenthesized
  | OPEN_PAR Expression COMMA ExprList CLOSE_PAR
  | ROW OPEN_PAR ExprList CLOSE_PAR
  | Subquery                                                                   #Subquery
  | EXISTS Subquery
  | OPEN_CURLY Identifier Expression CLOSE_CURLY
  | MATCH IdentListArg AGAINST OPEN_PAR BitExpression FulltextOptions? CLOSE_PAR
  | CAST_CALL_OPEN Expression (AT LOCAL)? AS CastType ArrayCast? CLOSE_PAR
  | CAST_CALL_OPEN Expression AT TIME ZONE INTERVAL? TextStringLiteral AS DATETIME TypeDatetimePrecision CLOSE_PAR
  | CASE Expression? (WhenExpression ThenExpression)+ ElseExpression? END
  | CONVERT OPEN_PAR Expression COMMA CastType CLOSE_PAR
  | CONVERT OPEN_PAR Expression USING CharsetName CLOSE_PAR
  | DEFAULT OPEN_PAR SimpleIdentifier CLOSE_PAR
  | VALUES OPEN_PAR SimpleIdentifier CLOSE_PAR
  > left Expression COLLATE TextOrIdentifier
  | BINARY Expression
  > LOGICAL_NOT Expression                                                     #Bang
  > (PLUS | MINUS | BITWISE_NOT) Expression                                     #Unary
  > left Expression BITWISE_XOR Expression                                     #BitXor
  > left Expression (MULT | DIV | MOD | KW_DIV | KW_MOD) Expression #Multiply
  > left Expression (PLUS | MINUS) Expression                                   #Add
  | Expression (PLUS | MINUS) INTERVAL Expression Interval                      #DateArithmetic
  | INTERVAL Expression Interval PLUS Expression
  > left Expression (SHIFT_LEFT | SHIFT_RIGHT) Expression                       #Shift
  > left Expression BITWISE_AND Expression                                     #BitAnd
  > left Expression BITWISE_OR Expression                                      #BitOr
  > left BitExpression NotRule? IN Subquery                                     #InQuery
  | BitExpression NotRule? IN OPEN_PAR InListExpressions CLOSE_PAR              #InList
  | BitExpression MEMBER OF? SimpleExprWithParentheses                          #Member
  | BitExpression SOUNDS LIKE BitExpression                                    #SoundsLike
  | BitExpression NotRule? LIKE SimpleExpression                               #Like
  | BitExpression NotRule? LIKE SimpleExpression ESCAPE SimpleExpression        #LikeEscape
  | BitExpression NotRule? REGEXP BitExpression                                 #Regexp
  | BitExpression NotRule? BETWEEN BitExpression AND Predicate                  #Between
  > left BooleanPrimary CompOp Predicate                                       #Compare
  | BooleanPrimary CompOp (ALL | ANY) Subquery                                  #QuantifiedCompare
  | BooleanPrimary IS NotRule? NULL                                            #IsNull
  > BooleanPrimary IS NotRule? (TRUE | FALSE | UNKNOWN)                          #IsTruth
  > NOT Expression                                                             #Not
  > left Expression (AND | LOGICAL_AND) Expression                              #And
  > left Expression XOR Expression                                             #Xor
  > left Expression (OR | LOGICAL_OR) Expression                                #Or
  > right UserVariable ASSIGN Expression                                       #Assign

// These are nonrecursive operand views, not precedence levels. Their exclusions
// express Oracle's operand categories, including LIKE's pattern and ESCAPE.
// Parenthesized is not excluded: `a LIKE (b + c)` remains valid.
SimpleExpression
  = Expression!BitXor!Multiply!Add!DateArithmetic!Shift!BitAnd!BitOr!InQuery!InList!Member!SoundsLike!Like!LikeEscape!Regexp!Between!Compare!QuantifiedCompare!IsNull!IsTruth!Not!And!Xor!Or

BitExpression
  = Expression!InQuery!InList!Member!SoundsLike!Like!LikeEscape!Regexp!Between!Compare!QuantifiedCompare!IsNull!IsTruth!Not!And!Xor!Or

Predicate
  = Expression!Compare!QuantifiedCompare!IsNull!IsTruth!Not!And!Xor!Or

BooleanPrimary
  = Expression!IsTruth!Not!And!Xor!Or

// A sole bare subquery takes the #InQuery path (including extra parentheses).
// A list with two or more elements may still contain scalar subqueries.
InListExpressions
  = Expression!Subquery       #Single
  | Expression COMMA ExprList #Multiple

// NULL has one derivation, rather than Literal -> NullLiteral and NullAsLiteral.
LiteralOrNull = Literal
SignedLiteralOrNull = SignedLiteral

// Extra parentheses around a bare scalar subquery belong to its query syntax.
// Expression!Subquery above removes only that duplicate derivation; an inner
// Add, Compare, etc. remains allowed, as in ((SELECT 1) + 2).
// A parenthesized query has one recursive wrapper. Oracle's two alternatives
// overlap through QueryExpressionBody -> QueryExpressionParens.
Subquery = OPEN_PAR QueryExpressionWithOptLockingClauses CLOSE_PAR

// The direct QueryExpressionParens alternative is redundant: the operand
// already reaches it through QueryExpression -> QueryExpressionBody, choosing
// empty optional clauses. Keep one derivation for each parenthesis nesting.
QueryExpressionParens
  = OPEN_PAR QueryExpressionWithOptLockingClauses CLOSE_PAR

// Function-call disambiguation is refined with the lexical keyword policy.
FunctionCall
  = UnqualifiedFunctionName OPEN_PAR UdfExprList? CLOSE_PAR
  | QualifiedPair OPEN_PAR ExprList? CLOSE_PAR

UnqualifiedFunctionName
  = PureIdentifier \ ContextualFunctionWord
  | ContextualFunctionName

// Prefer the complete adjacent-string sequence over an implicit string alias.
TextLiteral = TextLiteralHead TextStringLiteral* !>>> QuotedText
TextLiteralHead
  = CharsetIntroducer? TextStringLiteral #Ordinary
  | NationalText                        #National

// MySQL 8.2 simple_ident_q requires an identifier before a qualification dot.
// A standalone .col is not a column reference; admitting it also duplicates
// keyword-qualified names such as BINARY.col as unary BINARY applied to .col.
FieldIdentifier
  = Identifier
  | QualifiedPair DotIdentifier?

// MySQL's adjacent keyword-dot-name exception applies to the first qualifier
// as well as to later components. KeywordQualifiedPair is lexically disjoint
// from the ordinary Identifier path; separated and quoted names keep that path.
QualifiedPair
  = Identifier DotIdentifier
  | KeywordQualifiedPair

QualifiedIdentifier
  = Identifier
  | QualifiedPair

// MySQL persisted_variable_ident accepts one or two components, plus DEFAULT
// as the first component. QualifiedIdentifier already includes single names.
// Adjacent DEFAULT.word is an identifier pair under MySQL's lexer; reserve
// the explicit DEFAULT path for other spacing/quoting, avoiding two parses.
PersistedVariableIdentifier
  = QualifiedIdentifier
  | DEFAULT !>> AdjacentQualificationStart DotIdentifier

// MySQL ws_num_codepoints explicitly raises a syntax error for zero.
// Restrict this argument locally; zero remains valid in other number positions.
WsNumCodepoints
  = OPEN_PAR (RealUlongNumber \ ZeroIntegerValue) CLOSE_PAR

@Regex
ZeroIntegerValue = [0]+ | "0x" [0]+ | [xX] "'" [0]* "'"

SimpleIdentifier
  = Identifier
  | QualifiedPair DotIdentifier?

FilterTableRef = QualifiedPair

TableRefWithWildcard
  = Identifier (DOT MULT)?
  | QualifiedPair (DOT MULT)?

// MySQL 8.2 sql_yacc.yy:1420-1436 prefers DATE/TIME/TIMESTAMP followed by
// TEXT_STRING as temporal literals. Exclude only the bare expression-identifier
// interpretation before a string; quoted and qualified names stay identifiers.
// Other ColumnRef/Identifier positions (DDL, aliases, etc.) are unchanged.
ExpressionColumnRef
  = QualifiedPair DotIdentifier?
  | Identifier \ TemporalKeywordWord
  | TemporalKeyword !>>> QuotedText

@Regex
TemporalKeyword = TemporalKeywordWord !>> IdentifierPart

@Regex
TemporalKeywordWord = [dD] [aA] [tT] [eE] | [tT] [iI] [mM] [eE] | [tT] [iI] [mM] [eE] [sS] [tT] [aA] [mM] [pP]

// MySQL temporal_literal:15010 uses TEXT_STRING. Under default SQL quoting,
// this includes single- and double-quoted strings (not national/charset forms).
TemporalLiteral
  = DATE TextStringLiteral
  | TIME TextStringLiteral
  | TIMESTAMP TextStringLiteral

// After layout following a dot, retain ordinary identifier classification,
// including the existing charset-name allowance. The adjacent spelling below
// bypasses keyword/function classification, as MySQL's MY_LEX_IDENT_SEP does.
IdentifierAfterDot
  = Identifier
  | CharsetIdentifier

DotIdentifier
  = DotWordIdentifier
  | DotDigitIdentifier
  | DOT !>> IdentifierPart IdentifierAfterDot

TableWild
  = Identifier DOT MULT
  | QualifiedPair DOT MULT

// MySQL lvalue_ident excludes the five bare SET scope words. Before an
// adjacent qualification dot, keyword lookup is suppressed instead. Preserve
// that lexical distinction; lvalue_variable's parser action additionally
// rejects GLOBAL/LOCAL/SESSION as a two-part prefix, even when backtick quoted.
LvalueVariable
  = Identifier \ SetScopeWord
  | (Identifier \ SetScopeWord \ ForbiddenLvaluePrefix) DotIdentifier
  | PersistQualifiedPair
  | KeywordQualifiedPair
  | DEFAULT !>> AdjacentQualificationStart DotIdentifier

InstallLvalueVariable = LvalueVariable

OptionValueNoOptionType
  = LvalueVariable Equal SetExprOrDefault
  | Charset (CharsetName | DEFAULT)
  | UserVariable Equal Expression
  | SetSystemVariable Equal SetExprOrDefault
  | NAMES GroupOptionValueNoOptionType1

// The first word after @@ always undergoes keyword lookup (sql_lex.cc:2083).
// After an explicit scope dot, an adjacent word is an identifier instead.
// Scoped name rules separate adjacent raw words from ordinary classification
// after layout, using lexical precede restrictions on the name itself.
SetSystemVariable
  = AT_AT_SIGN SetVarIdentType ScopedSetVariable
  | AT_AT_SIGN UnscopedSetVariable

ScopedSetVariable
  = ScopedLvalueIdentifier
  | (ScopedLvalueIdentifier \ ForbiddenLvaluePrefix) DotIdentifier
  | DotCharacter !<< KeywordQualifiedPair
  | DotCharacter !<< PersistQualifiedPair
  | DotCharacter !<< DEFAULT !>> AdjacentQualificationStart DotIdentifier

ScopedLvalueIdentifier
  = DotCharacter !<< (Identifier \ SetScopeWord)
  | AdjacentScopedWord
  | AdjacentScopedDigitWord
  | NonDotCharacter !<< BacktickIdentifier

UnscopedSetVariable
  = SystemVariableIdentifier \ SetScopeWord
  | (SystemVariableIdentifier \ SetScopeWord \ ForbiddenLvaluePrefix) DotIdentifier
  | DEFAULT DotIdentifier

// MY_LEX_IDENT_OR_KEYWORD scans ident_map+ directly after @@. Numeric,
// exponent-like and charset-looking names are identifiers in this position.
// Only backticks enter the quoted-identifier path; string names are not valid
// here (they are valid later, after an explicit scope dot).
SystemVariableIdentifier
  = SystemVariableWord
  | BacktickIdentifier

// IGUANA-009 workaround: check the one-character context at the dot,
// rather than a two-character lookbehind at the following numeric name.
SetVarIdentType = (PERSIST | PERSIST_ONLY | GLOBAL | LOCAL | SESSION) SystemScopeDot
RvalueSystemVariableType = (GLOBAL | LOCAL | SESSION) SystemScopeDot
SystemScopeDot = DOT !>> DigitCharacter | DigitScopeDot

// Prefer the lexical @name form when the name is adjacent. The other form
// handles whitespace and quoted names, preserving Oracle's accepted spellings.
UserVariable
  = AtTextSuffix
  | AT_SIGN !>> UserVariableCharacter TextOrIdentifier

// MySQL 8.2 sql_yacc.yy:14758-14784: every LOAD target is a column or
// user variable. Reuse the lexical disambiguation above for every position;
// a bare @@ is not a target. Adjacent dotted names remain UserVariable tokens.
FieldOrVariable
  = ColumnRef
  | UserVariable

FieldOrVariableList
  = FieldOrVariable (COMMA FieldOrVariable)*

// MySQL rvalue_system_variable rejects GLOBAL/LOCAL/SESSION as the first
// component of a two-part name, including decoded quoted spellings. The same
// exclusion selects the explicit scope interpretation for @@session.name.
RvalueSystemOrUserVariable
  = UserVariable
  | AT_AT_SIGN RvalueSystemVariableType RvalueSystemVariable
  | AT_AT_SIGN UnscopedSystemVariable

UnscopedSystemVariable
  = SystemVariableIdentifier
  | (SystemVariableIdentifier \ ForbiddenLvaluePrefix) DotIdentifier

// After a scope dot, ordinary scanning resumes. Adjacent reserved words are
// identifiers, as are reserved first qualifiers before an adjacent dot. Keep
// these lexical paths disjoint from TextOrIdentifier and from one another.
RvalueSystemVariable
  = ScopedRvalueName
  | (ScopedRvalueName \ ForbiddenRvaluePrefix) DotIdentifier
  | DotCharacter !<< KeywordQualifiedPair

ScopedRvalueName
  = DotCharacter !<< Identifier
  | AdjacentScopedWord
  | AdjacentScopedDigitWord
  | NonDotCharacter !<< BacktickIdentifier
  | TextStringLiteral

// MySQL 8.2 sql_yacc.yy:8436 uses only alter_user_list for this ALTER path.
// Oracle's additional CreateUserList branch duplicates ordinary authentication
// forms and incorrectly accepts CREATE-only MFA/INITIAL AUTHENTICATION syntax.
// This is a conformance correction: those invalid ALTER forms are removed.
GroupAlterUserStatement3
  = AlterUserList CreateUserTail #Option1
  | UserFunction GroupAlterUserStatement1 #Option2
  | User GroupAlterUserStatement2 #Option3

// MySQL 8.2 sql_yacc.yy:8504-8516,16978: opt_user_registration is nonempty.
// Require the operation on both registration branches. Bare named users keep
// the ordinary AlterUserList path; bare USER() has no valid MySQL alternative.
GroupAlterUserStatement1
  = (IdentifiedByRandomPassword | IdentifiedByPassword) ReplacePassword? RetainCurrentPassword? #Option1
  | DISCARD OLD PASSWORD #Option2
  | UserRegistration #Option3

GroupAlterUserStatement2
  = DEFAULT ROLE (ALL | NONE | RoleList) #Option1
  | UserRegistration #Option2

// MySQL 8.2 sql_yacc.yy:17150: opt_initial_auth is nonempty despite its name.
// Plugin-only authentication remains covered by Identification in Option1.
GroupCreateUser1
  = Identification CreateUserWithMfa? #Option1
  | IdentifiedWithPlugin InitialAuth #Option2
  | CreateUserWithMfa #Option3

// MySQL 8.2 sql_yacc.yy:5928: empty or ADD ts_datafile, once each.
// The imported mandatory alternative was already covered by this optional.
TsDataFileName
  = (ADD TsDataFile)?

// MySQL 8.2 sql_yacc.yy:13350: query with absent, empty or populated columns.
// QueryExpression includes QueryExpressionParens; the locking wrapper covers
// both, so separate query and parenthesized-query alternatives are redundant.
InsertQueryExpression
  = (OPEN_PAR Fields? CLOSE_PAR)? QueryExpressionWithOptLockingClauses

// MySQL 8.2 sql_yacc.yy:11327-11361: StableInteger already includes integer
// literals, parameters and variables. Removing the broader number branch also
// rejects decimal/float and out-of-u64 literals, as MySQL does at parse time.
LeadLagInfo
  = COMMA StableInteger (COMMA Expression)?

// MySQL 8.2 sql_yacc.yy:16871-16940: five nonoverlapping privilege targets.
// Do not reuse TableRef here: its optional schema duplicates these paths and
// admits leading-dot, double-dot and three-part names that grant_ident rejects.
// DotIdentifier retains the existing handling of identifiers after a dot.
GrantIdentifier
  = MULT
  | MULT DOT MULT
  | SchemaRef DOT MULT
  | Identifier
  | QualifiedPair

// MySQL 8.2 sql_yacc.yy:17440 expects an account through the user rule.
// Oracle's USER_SYMBOL here incorrectly restricts AS to the literal USER.
GrantAs
  = AS User WithRoles?

// MySQL 8.2 sql_yacc.yy:9870-9903,10033-10081 prefers shifting INTO after
// the select list over reducing an empty FROM clause. Like dangling else,
// the branch without early INTO must not finish its select list before INTO.
// Trailing INTO remains available after FROM/WHERE/ORDER/etc.
// Intentionally overaccept nested and repeated INTO clauses, e.g.
// SELECT (SELECT 1 INTO @x); and SELECT 1 INTO @x INTO @y;.
// MySQL rejects these during parse-tree contextualization. Keep the grammar
// natural and leave these restrictions to a later validation step (not yet
// implemented here); successful parsing alone does not establish MySQL validity.
QuerySpecification
  = SELECT SelectOption* !>>> SelectOptionBoundaryKeyword SelectItemList IntoClause FromClause? WhereClause? GroupByClause? HavingClause? WindowClause? QualifyClause?
  | SELECT SelectOption* !>>> SelectOptionBoundaryKeyword SelectItemList !>>> INTO FromClause? WhereClause? GroupByClause? HavingClause? WindowClause? QualifyClause?

// MySQL 8.2 shifts these nonreserved keywords into the SELECT option list,
// rather than ending that list and treating the word as a column. Restrict
// only this boundary: quoted names, parenthesized expressions and later items
// retain their identifier uses. sql_lex.cc:1564 bypasses keyword lookup before
// an adjacent dot/name, so SQL_NO_CACHE.col must not trigger this restriction.
@Regex
SelectOptionBoundaryKeyword = SelectOptionBoundaryWord !>> IdentifierPart !>> AdjacentQualificationStart

@Regex
SelectOptionBoundaryWord = [sS] [qQ] [lL] "_" [nN] [oO] "_" [cC] [aA] [cC] [hH] [eE] | [sS] [qQ] [lL] "_" [bB] [uU] [fF] [fF] [eE] [rR] "_" [rR] [eE] [sS] [uU] [lL] [tT]

@Regex
AdjacentQualificationStart = "." IdentifierPart

// MySQL 8.2 sql_yacc.yy:1446-1447 and 9973-9997: INTERSECT binds
// tighter than UNION/EXCEPT; both levels associate to the left. Parenthesized
// queries remain atoms. UnionOption preserves each operator's ALL/DISTINCT.
QueryExpressionBody
  = QueryPrimary
  | QueryExpressionParens
  > left QueryExpressionBody INTERSECT UnionOption? QueryExpressionBody #Intersect
  > left QueryExpressionBody UNION UnionOption? QueryExpressionBody #Union
  | QueryExpressionBody EXCEPT UnionOption? QueryExpressionBody #Except

// MySQL 8.2 sql_yacc.yy:11918-12048: natural binary joins. The lower,
// right-associative conditionless alternative models CONDITIONLESS_JOIN's
// delayed reduction. ON/USING must attach before this alternative completes.
// These are MySQL's syntactic derivations, before its add_cross_join AST
// rearrangement. Do not flatten them or force all joins left-associative.
// Keep recursion direct: helper-mediated associativity has a recorded Iguana
// bug on upstream 52e2a6d (feedback/indirect-join-associativity.iggy).
TableReference
  = TableFactor #Factor
  | OPEN_CURLY OJ EscapedTableReference CLOSE_CURLY #Escaped
  > left TableReference InnerJoinType TableReference JoinSpecification #Inner
  | TableReference OuterJoinType TableReference JoinSpecification #Outer
  | TableReference NaturalJoinType TableFactor #Natural
  > right TableReference InnerJoinType TableReference !>>> JoinSpecificationStart #Conditionless

JoinSpecification
  = ON Expression
  | USING IdentifierListWithParentheses

// As in MySQL esc_table_reference: a factor or a join, not another standalone
// escape. Escaped operands within joins remain available through TableReference.
EscapedTableReference = TableReference!Escaped

// MySQL 8.2 sql_yacc.yy:12091-12155 gives each table-parenthesis category
// its own rule. Comma lists have at least two elements; single tables and
// joins have separate paths. This also rejects Oracle's extra wrappers around
// an already aliased derived table or a standalone JSON_TABLE/ODBC factor.
TableFactor
  = SingleTable
  | SingleTableParens
  | DerivedTable
  | JoinedTableParens
  | TableReferenceListParens
  | TableFunction

TableReferenceListParens
  = OPEN_PAR TableReferenceListParens CLOSE_PAR
  | OPEN_PAR TableReferenceList COMMA TableReference CLOSE_PAR

// Select a JOIN at the root, retaining natural direct recursion in its operands.
// Excluding Factor avoids duplicate single/list/nested-parenthesis derivations.
// Excluding Escaped matches MySQL's joined_table category: a standalone ODBC
// escape cannot be parenthesized here, but escapes remain legal JOIN operands.
JoinedTableParens
  = OPEN_PAR JoinedTableParens CLOSE_PAR
  | OPEN_PAR TableReference!Factor!Escaped CLOSE_PAR

@Regex
JoinSpecificationStart = ([oO] [nN] | [uU] [sS] [iI] [nN] [gG]) !>> IdentifierPart

// MySQL 8.2 sql_yacc.yy:12336 repeats hints without a comma between them.
// Commas separate index names inside each hint, not successive hints. Mixed
// USE/FORCE conflicts are checked later when MySQL processes table hints.
IndexHintList = IndexHint+

// MySQL 8.2 sql_yacc.yy:14567 requires INFILE, URL or S3 even when FROM
// is present. Oracle's optional LoadSourceType overaccepts a bare filename.
LoadStatement
  = LOAD DataOrXml LoadDataLock? LoadFrom? LOCAL? LoadSourceType TextStringLiteral SourceCount? SourceOrder? ((REPLACE | IGNORE))? INTO TABLE TableRef UsePartition? CharsetClause? XmlRowsIdentifiedBy? FieldsClause? LinesClause? LoadDataFileTail LoadParallel? LoadMemory? LoadAlgorithm?

// sql_yacc.yy:14645 explicitly raises a syntax error unless the identifier
// spells COUNT. A quoted COUNT remains an identifier in the server lexer.
SourceCount = SourceCountName IntegerLiteral

SourceCountName = SourceCountWord | QuotedSourceCountWord

@Regex
SourceCountWord = [cC] [oO] [uU] [nN] [tT] !>> IdentifierPart

@Regex
QuotedSourceCountWord = "`" [cC] [oO] [uU] [nN] [tT] "`"

// sql_yacc.yy:7443 permits decimal numeric tokens in field lengths but no
// hexadecimal token. Hex remains legal in other RealUlonglongNumber uses.
FieldLength
  = OPEN_PAR ((RealUlonglongNumber \ HexPattern) | DecimalLiteral) CLOSE_PAR

// YEAR's parse action uses strtoul(base 10) and aborts unless the result is 4.
// Preserve its acceptance of leading zeroes and fractional suffixes (004.5),
// rather than imposing a stricter interpretation of the manual's YEAR(4).
YearFieldLength
  = OPEN_PAR (((RealUlonglongNumber \ HexPattern) | DecimalLiteral) \ NonFourYearLength) CLOSE_PAR

// Exclude precisely the decimal spellings whose integer prefix is not four.
// This pattern is unrestricted so it can serve as an except operand.
@Regex
NonFourYearLength
  = [0]+ ("." [0-9]*)?
  | [0]* [1-35-9] [0-9]* ("." [0-9]*)?
  | [0]* "4" [0-9]+ ("." [0-9]*)?
  | "." [0-9]+

// MySQL size_number checks IDENT_sys during parsing: K/M/G suffix and a
// nonnegative prefix below 2^31. Numeric tokens retain their separate range.
SizeNumber = RealUlonglongNumber | StorageSizeWord | QuotedStorageSize

// Only unquoted base-prefixed tokens need an identifier boundary. A closing
// quote delimits the other forms, including when a SELECT alias is adjacent.
// The lexical alternatives retain longest match and validate digit contents.
HexLiteral = UnquotedHexLiteral | QuotedHexLiteral

BinaryLiteral = UnquotedBinaryLiteral | QuotedBinaryLiteral

// MySQL 8.2 sql_yacc.yy:9250 puts options after START GROUP_REPLICATION.
// Oracle's ANTLR rule places them between START and GROUP_REPLICATION.
// STOP has no options. Credential contents remain a separate server check.
GroupReplication
  = START GROUP_REPLICATION GroupReplicationStartOptions?
  | STOP GROUP_REPLICATION

// sql_yacc.yy:16446 requires INSTANCE for every action. RELOAD TLS permits
// neither, either, or both optional clauses, with FOR CHANNEL before NO.
// The imported Oracle alternatives omit INSTANCE and require a TLS option.
AlterInstanceStatement
  = INSTANCE ROTATE RotationEngine MASTER KEY
  | INSTANCE RELOAD TLS GroupAlterInstanceStatement1?
  | INSTANCE (ENABLE | DISABLE) InnodbName RedoLogName
  | INSTANCE RELOAD KEYRING

// MySQL checks these names during parsing using its Unicode case table.
// String-valued ROTATE names remain permissive pending a readable grammar
// representation for the server's decoded, NUL-terminated comparison.
// Identifier-valued names are exact, including the U+0130 case equivalent.
RotationEngine = InnodbName | BinlogName | TextStringLiteral

InnodbName = InnodbNameWord | QuotedInnodbName

BinlogName = BinlogNameWord | QuotedBinlogName

RedoLogName = RedoLogNameWord | QuotedRedoLogName

@Regex
InnodbNameWord = [iIİ] [nN] [nN] [oO] [dD] [bB] !>> IdentifierPart

@Regex
QuotedInnodbName = "`" [iIİ] [nN] [nN] [oO] [dD] [bB] "`" !>> BacktickCharacter

@Regex
BinlogNameWord = [bB] [iIİ] [nN] [lL] [oO] [gG] !>> IdentifierPart

@Regex
QuotedBinlogName = "`" [bB] [iIİ] [nN] [lL] [oO] [gG] "`" !>> BacktickCharacter

@Regex
RedoLogNameWord = [rR] [eE] [dD] [oO] "_" [lL] [oO] [gG] !>> IdentifierPart

@Regex
QuotedRedoLogName = "`" [rR] [eE] [dD] [oO] "_" [lL] [oO] [gG] "`" !>> BacktickCharacter

// Adjacent backticks belong to one quoted identifier as an escaped backtick;
// they cannot split into two name tokens at this boundary.
@Regex
BacktickCharacter = "`"

// sql_yacc.yy:14140 allows FOR DATABASE only on explained SQL statements.
// Exclude the connection alternative when that schema clause is present.
ExplainStatement
  = (EXPLAIN | DESCRIBE | DESC) ExplainOptions? ExplainableStatement
  | (EXPLAIN | DESCRIBE | DESC) ExplainOptions? FOR DATABASE TextOrIdentifier ExplainableStatement!Connection

ExplainableStatement
  = SelectStatement
  | DeleteStatement
  | InsertStatement
  | ReplaceStatement
  | UpdateStatement
  | FOR CONNECTION RealUlongNumber #Connection

// MySQL checks format names and nonempty INTO targets during parsing.
// Empty quoted targets bypass the length guard, even without FORMAT.
// Quoted format strings remain permissive pending the decoded-string/NUL
// notation decision; identifier-valued formats enforce the exact names.
ExplainOptions
  = ANALYZE (FORMAT EQUAL ExplainFormatName)?
  | FORMAT EQUAL JsonExplainFormat ExplainInto?
  | FORMAT EQUAL OtherExplainFormat EmptyExplainInto?
  | FORMAT EQUAL TextStringLiteral ExplainInto?
  | EmptyExplainInto

ExplainFormatName = JsonExplainFormat | OtherExplainFormat | TextStringLiteral

JsonExplainFormat = JsonFormatWord | QuotedJsonFormat

OtherExplainFormat = OtherFormatWord | QuotedOtherFormat

EmptyExplainInto = INTO AT_SIGN EmptyQuotedExplainTarget

@Regex
JsonFormatWord = [jJ] [sS] [oO] [nN] !>> IdentifierPart

@Regex
QuotedJsonFormat = "`" [jJ] [sS] [oO] [nN] "`" !>> BacktickCharacter

@Regex
OtherFormatPattern = [tT] [rR] [eE] [eE] | [tT] [rR] [aA] [dD] [iIİ] [tT] [iIİ] [oO] [nN] [aA] [lL]

@Regex
OtherFormatWord = OtherFormatPattern !>> IdentifierPart

@Regex
QuotedOtherFormat = "`" OtherFormatPattern "`" !>> BacktickCharacter

@Regex
EmptyQuotedExplainTarget = "''" | "\"\"" | "``"

// MySQL 8.2 sql_yacc.yy:17480 rejects AND CHAIN with positive RELEASE
// during COMMIT/ROLLBACK parsing. This is an intentional language reduction:
// the second completion alternative excludes the positive Chain choice.
// AND NO CHAIN RELEASE and AND CHAIN NO RELEASE remain valid.
TransactionStatement
  = START TRANSACTION StartTransactionOptions?
  | COMMIT WORK? TransactionCompletion

GroupSavepointStatement1
  = TO SAVEPOINT? Identifier #Option1
  | TransactionCompletion #Option2

TransactionCompletion
  = TransactionChain? (NO RELEASE)?
  | (TransactionChain!Chain)? RELEASE

TransactionChain
  = AND CHAIN #Chain
  | AND NO CHAIN

// MySQL 8.2 sql_yacc.yy:9375 rejects lists containing both access modes.
// The first READ option selects the branch; preceding options can only be
// snapshots. Exclude the opposite mode from the remaining list. Repeated
// snapshots and repeated occurrences of the selected mode remain valid.
// This is a parse-time language restriction, not an ambiguity preference.
StartTransactionOptions
  = StartTransactionSnapshot (COMMA StartTransactionSnapshot)* #Snapshots
  | (StartTransactionSnapshot COMMA)* READ ONLY (COMMA StartTransactionOptionList!ReadWrite)* #ReadOnly
  | (StartTransactionSnapshot COMMA)* READ WRITE (COMMA StartTransactionOptionList!ReadOnly)* #ReadWrite

StartTransactionSnapshot
  = WITH CONSISTENT SNAPSHOT

StartTransactionOptionList
  = StartTransactionSnapshot
  | READ ONLY #ReadOnly
  | READ WRITE #ReadWrite

// MySQL 8.2 sql_yacc.yy:9175-9222 validates these identifier values during
// parsing. DEFAULT is a keyword alternative, so quoted DEFAULT is invalid.
// The same rules govern CREATE/DROP INDEX options. Keep MySQL case folding
// (including U+0130 for i), identifier boundaries and doubled-backtick rules.
AlterAlgorithmOption
  = ALGORITHM EQUAL? (DEFAULT | AlterAlgorithmName)

AlterLockOption
  = LOCK EQUAL? (DEFAULT | AlterLockName)

AlterAlgorithmName
  = AlgorithmNameWord | QuotedAlgorithmName

AlterLockName
  = LockNameWord | QuotedLockName

@Regex
AlgorithmNamePattern
  = [iIİ] [nN] [pP] [lL] [aA] [cC] [eE]
  | [iIİ] [nN] [sS] [tT] [aA] [nN] [tT]
  | [cC] [oO] [pP] [yY]

@Regex
AlgorithmNameWord = AlgorithmNamePattern !>> IdentifierPart

@Regex
QuotedAlgorithmName = "`" AlgorithmNamePattern "`" !>> BacktickCharacter

@Regex
LockNamePattern
  = [nN] [oO] [nN] [eE]
  | [sS] [hH] [aA] [rR] [eE] [dD]
  | [eE] [xX] [cC] [lL] [uU] [sS] [iIİ] [vV] [eE]

@Regex
LockNameWord = LockNamePattern !>> IdentifierPart

@Regex
QuotedLockName = "`" LockNamePattern "`" !>> BacktickCharacter

// MySQL 8.2, default quoting and backslash escapes. SQL mode changes in SET
// statements are parsed as SQL; they do not mutate this grammar's profile.
@Layout
Layout = (WhiteSpace | BlockComment | HashComment | DashComment)* !>> WhiteSpace !>> BlockComment !>> HashComment !>> DashComment

@Regex
WhiteSpace = [\ \t\r\n\f]+

// /*!...*/ is executable SQL and is intentionally not ordinary layout.
@Regex
BlockComment = "/*" ((![*!] | [*]+ ![*/]) (![*] | [*]+ ![*/])*)? [*]+ "/" | "/**/"

// MySQL MY_LEX_COMMENT stops at LF or EOF; a bare CR stays inside a comment.
@Regex
HashComment = "#" ![\n]*

@Regex
DashComment = "--" ([\ \t\r\f] ![\n]*)? !>> NonLineEnd

// The line-end restriction admits a bare -- only at EOF or before LF.
// Before another character it is two minus operators, not a comment. Keep
// comment kinds separate in Layout: restricted regexes cannot be composed in
// a larger regex, and disjoint initial characters keep Layout LL(1).
@Regex
NonLineEnd = ![\n]

@Regex
IdentifierStart = [a-zA-Z_$-￿]

// Expanded by the importer to 0..2147483647, with leading zeroes. Unlike
// IntegerLiteral this pattern has no restrictions, so regexes can compose it.
@Regex
StorageSizeValue = [0]* ([0-9] | ("1" [0-9] | "9" [0-9] | [2-8] [0-9]) | ("1" [0-9] [0-9] | "9" [0-9] [0-9] | [2-8] [0-9] [0-9]) | ("1" [0-9] [0-9] [0-9] | "9" [0-9] [0-9] [0-9] | [2-8] [0-9] [0-9] [0-9]) | ("1" [0-9] [0-9] [0-9] [0-9] | "9" [0-9] [0-9] [0-9] [0-9] | [2-8] [0-9] [0-9] [0-9] [0-9]) | ("1" [0-9] [0-9] [0-9] [0-9] [0-9] | "9" [0-9] [0-9] [0-9] [0-9] [0-9] | [2-8] [0-9] [0-9] [0-9] [0-9] [0-9]) | ("1" [0-9] [0-9] [0-9] [0-9] [0-9] [0-9] | "9" [0-9] [0-9] [0-9] [0-9] [0-9] [0-9] | [2-8] [0-9] [0-9] [0-9] [0-9] [0-9] [0-9]) | ("1" [0-9] [0-9] [0-9] [0-9] [0-9] [0-9] [0-9] | "9" [0-9] [0-9] [0-9] [0-9] [0-9] [0-9] [0-9] | [2-8] [0-9] [0-9] [0-9] [0-9] [0-9] [0-9] [0-9]) | ("1" [0-9] [0-9] [0-9] [0-9] [0-9] [0-9] [0-9] [0-9] | "9" [0-9] [0-9] [0-9] [0-9] [0-9] [0-9] [0-9] [0-9] | [2-8] [0-9] [0-9] [0-9] [0-9] [0-9] [0-9] [0-9] [0-9]) | ("1" [0-9] [0-9] [0-9] [0-9] [0-9] [0-9] [0-9] [0-9] [0-9] | "2" ("0" [0-9] [0-9] [0-9] [0-9] [0-9] [0-9] [0-9] [0-9] | "1" ("0" [0-9] [0-9] [0-9] [0-9] [0-9] [0-9] [0-9] | "4" ("0" [0-9] [0-9] [0-9] [0-9] [0-9] [0-9] | "7" ("0" [0-9] [0-9] [0-9] [0-9] [0-9] | "4" ("0" [0-9] [0-9] [0-9] [0-9] | "8" ("0" [0-9] [0-9] [0-9] | "3" ("0" [0-9] [0-9] | "6" ("0" [0-9] | "4" ("0" | "7" | [1-6]) | [1-3] [0-9]) | [1-5] [0-9] [0-9]) | [1-2] [0-9] [0-9] [0-9]) | [1-7] [0-9] [0-9] [0-9] [0-9]) | [1-3] [0-9] [0-9] [0-9] [0-9] [0-9]) | [1-6] [0-9] [0-9] [0-9] [0-9] [0-9] [0-9]) | [1-3] [0-9] [0-9] [0-9] [0-9] [0-9] [0-9] [0-9]))))

