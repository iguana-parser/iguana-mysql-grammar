CAST_CALL_OPEN = ([cC] [aA] [sS] [tT] "(")

@Regex
COUNT_CALL_OPEN = ([cC] [oO] [uU] [nN] [tT] "(")

@Regex
CURDATE_CALL_OPEN = ([cC] [uU] [rR] [dD] [aA] [tT] [eE] "(" | [cC] [uU] [rR] [rR] [eE] [nN] [tT] "_" [dD] [aA] [tT] [eE] "(")

