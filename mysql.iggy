// Adapted from three sources:
// - Oracle's MySQL Reference Manual: https://dev.mysql.com/doc/refman/
// - MySQL's yacc parser (sql/sql_yacc.yy), MySQL 8.2.0:
//   https://github.com/mysql/mysql-server/tree/87307d4ddd88405117e3f1e51323836d57ab1f57
// - Oracle's ANTLR grammar (MySQLParser.g4 and MySQLLexer.g4):
//   https://github.com/antlr/grammars-v4/tree/8c7680c4d28a2c84c8a1077a8b3dad4b37b300df/sql/mysql/Oracle
//   Copyright © 2025, Oracle and/or its affiliates. Author: Mike Lischke.

grammar MySQL

Queries
  = Query* FinalQuery?

Query
  = (SimpleStatement | BeginWork) SEMICOLON

SimpleStatement
  = AlterStatement
  | CreateStatement
  | DropStatement
  | RenameTableStatement
  | TruncateTableStatement
  | ImportStatement
  | CallStatement
  | DeleteStatement
  | DoStatement
  | HandlerStatement
  | InsertStatement
  | LoadStatement
  | ReplaceStatement
  | SelectStatement
  | UpdateStatement
  | TransactionOrLockingStatement
  | ReplicationStatement
  | PreparedStatement
  | CloneStatement
  | AccountManagementStatement
  | TableAdministrationStatement
  | UninstallStatement
  | InstallStatement
  | SetStatement
  | ShowDatabasesStatement
  | ShowTablesStatement
  | ShowTriggersStatement
  | ShowEventsStatement
  | ShowTableStatusStatement
  | ShowOpenTablesStatement
  | ShowParseTreeStatement
  | ShowPluginsStatement
  | ShowEngineLogsStatement
  | ShowEngineMutexStatement
  | ShowEngineStatusStatement
  | ShowColumnsStatement
  | ShowBinaryLogsStatement
  | ShowBinaryLogStatusStatement
  | ShowReplicasStatement
  | ShowBinlogEventsStatement
  | ShowRelaylogEventsStatement
  | ShowKeysStatement
  | ShowEnginesStatement
  | ShowCountWarningsStatement
  | ShowCountErrorsStatement
  | ShowWarningsStatement
  | ShowErrorsStatement
  | ShowProfilesStatement
  | ShowProfileStatement
  | ShowStatusStatement
  | ShowProcessListStatement
  | ShowVariablesStatement
  | ShowCharacterSetStatement
  | ShowCollationStatement
  | ShowPrivilegesStatement
  | ShowGrantsStatement
  | ShowCreateDatabaseStatement
  | ShowCreateTableStatement
  | ShowCreateViewStatement
  | ShowMasterStatusStatement
  | ShowReplicaStatusStatement
  | ShowCreateProcedureStatement
  | ShowCreateFunctionStatement
  | ShowCreateTriggerStatement
  | ShowProcedureStatusStatement
  | ShowFunctionStatusStatement
  | ShowProcedureCodeStatement
  | ShowFunctionCodeStatement
  | ShowCreateEventStatement
  | ShowCreateUserStatement
  | ResourceGroupManagement
  | OtherAdministrativeStatement
  | UtilityStatement
  | GetDiagnosticsStatement
  | SignalStatement
  | ResignalStatement

AlterStatement
  = ALTER GroupAlterStatement1

AlterDatabase
  = DATABASE SchemaRef? AlterDatabaseOption+

AlterDatabaseOption
  = CreateDatabaseOption
  | READ ONLY EQUAL? TernaryOption

AlterEvent
  = DefinerClause? EVENT EventRef (ON SCHEDULE Schedule)? (ON COMPLETION NOT? PRESERVE)? (RENAME TO QualifiedIdentifier)? GroupAlterEvent1? (COMMENT TextLiteral)? (DO CompoundStatement)?

AlterLogfileGroup
  = LOGFILE GROUP LogfileGroupRef ADD UNDOFILE TextLiteral AlterLogfileGroupOptions?

AlterLogfileGroupOptions
  = AlterLogfileGroupOption (COMMA? AlterLogfileGroupOption)*

AlterLogfileGroupOption
  = TsOptionInitialSize
  | TsOptionEngine
  | TsOptionWait

AlterServer
  = SERVER ServerRef ServerOptions

AlterTable
  = OnlineOption? TABLE TableRef AlterTableActions?

AlterTableActions
  = AlterCommandList ((PartitionClause | RemovePartitioning))?
  | PartitionClause
  | RemovePartitioning
  | (AlterCommandsModifierList COMMA)? StandaloneAlterCommands

AlterCommandList
  = AlterCommandsModifierList
  | (AlterCommandsModifierList COMMA)? AlterList

AlterCommandsModifierList
  = AlterCommandsModifier (COMMA AlterCommandsModifier)*

StandaloneAlterCommands
  = DISCARD TABLESPACE
  | IMPORT TABLESPACE
  | AlterPartition
  | (SECONDARY_LOAD | SECONDARY_UNLOAD)

AlterPartition
  = ADD PARTITION NoWriteToBinLog? GroupAlterPartition1
  | DROP PARTITION IdentifierList
  | REBUILD PARTITION NoWriteToBinLog? AllOrPartitionNameList
  | OPTIMIZE PARTITION NoWriteToBinLog? AllOrPartitionNameList NoWriteToBinLog?
  | ANALYZE PARTITION NoWriteToBinLog? AllOrPartitionNameList
  | CHECK PARTITION AllOrPartitionNameList CheckOption*
  | REPAIR PARTITION NoWriteToBinLog? AllOrPartitionNameList RepairType*
  | COALESCE PARTITION NoWriteToBinLog? RealUlongNumber
  | TRUNCATE PARTITION AllOrPartitionNameList
  | REORGANIZE PARTITION NoWriteToBinLog? (IdentifierList INTO PartitionDefinitions)?
  | EXCHANGE PARTITION Identifier WITH TABLE TableRef WithValidation?
  | DISCARD PARTITION AllOrPartitionNameList TABLESPACE
  | IMPORT PARTITION AllOrPartitionNameList TABLESPACE

AlterList
  = (AlterListItem | CreateTableOptionsSpaceSeparated) (COMMA (AlterListItem | AlterCommandsModifier | CreateTableOptionsSpaceSeparated))*

AlterCommandsModifier
  = AlterAlgorithmOption
  | AlterLockOption
  | WithValidation

AlterListItem
  = ADD COLUMN? GroupAlterListItem1
  | ADD TableConstraintDef
  | CHANGE COLUMN? ColumnInternalRef Identifier FieldDefinition Place?
  | MODIFY COLUMN? ColumnInternalRef FieldDefinition Place?
  | DROP GroupAlterListItem2
  | DISABLE KEYS
  | ENABLE KEYS
  | ALTER COLUMN? ColumnInternalRef GroupAlterListItem3
  | ALTER KW_INDEX IndexRef Visibility
  | ALTER CHECK Identifier ConstraintEnforcement
  | ALTER CONSTRAINT Identifier ConstraintEnforcement
  | RENAME COLUMN ColumnInternalRef TO Identifier
  | RENAME ((TO | AS))? TableName
  | RENAME KeyOrIndex IndexRef TO IndexName
  | CONVERT TO Charset (DEFAULT | CharsetName) Collate?
  | FORCE
  | ORDER BY AlterOrderList

Place
  = AFTER Identifier
  | FIRST

Restrict
  = RESTRICT
  | CASCADE

AlterOrderList
  = Identifier Direction? (COMMA Identifier Direction?)*

IndexLockAndAlgorithm
  = AlterAlgorithmOption AlterLockOption?
  | AlterLockOption AlterAlgorithmOption?

WithValidation
  = (WITH | WITHOUT) VALIDATION

RemovePartitioning
  = REMOVE PARTITIONING

AllOrPartitionNameList
  = ALL
  | IdentifierList

AlterTablespace
  = TABLESPACE TablespaceRef GroupAlterTablespace1

AlterUndoTablespace
  = UNDO TABLESPACE TablespaceRef SET (ACTIVE | INACTIVE) UndoTableSpaceOptions?

UndoTableSpaceOptions
  = UndoTableSpaceOption (COMMA? UndoTableSpaceOption)*

UndoTableSpaceOption
  = TsOptionEngine

AlterTablespaceOptions
  = AlterTablespaceOption (COMMA? AlterTablespaceOption)*

AlterTablespaceOption
  = INITIAL_SIZE EQUAL? SizeNumber
  | TsOptionAutoextendSize
  | TsOptionMaxSize
  | TsOptionEngine
  | TsOptionWait
  | TsOptionEncryption
  | TsOptionEngineAttribute

ChangeTablespaceOption
  = INITIAL_SIZE EQUAL? SizeNumber
  | TsOptionAutoextendSize
  | TsOptionMaxSize

AlterView
  = ViewAlgorithm? DefinerClause? ViewSuid? VIEW ViewRef ViewTail

ViewTail
  = ColumnInternalRefList? AS ViewQueryBlock

ViewQueryBlock
  = QueryExpressionWithOptLockingClauses ViewCheckOption?

ViewCheckOption
  = WITH ((CASCADED | LOCAL))? CHECK OPTION

CreateStatement
  = CREATE (CreateDatabase | CreateTable | CreateFunction | CreateProcedure | CreateUdf | CreateLogfileGroup | CreateView | CreateTrigger | CreateIndex | CreateServer | CreateTablespace | CreateEvent | CreateRole | CreateSpatialReference | CreateUndoTablespace)

CreateDatabase
  = DATABASE IfNotExists? SchemaName CreateDatabaseOption*

CreateDatabaseOption
  = DefaultCharset
  | DefaultCollation
  | DefaultEncryption

CreateTable
  = TEMPORARY? TABLE IfNotExists? TableName GroupCreateTable1

TableElementList
  = TableElement (COMMA TableElement)*

TableElement
  = ColumnDefinition
  | TableConstraintDef

DuplicateAsQe
  = ((REPLACE | IGNORE))? AsCreateQueryExpression

AsCreateQueryExpression
  = AS? QueryExpressionWithOptLockingClauses

QueryExpressionOrParens
  = QueryExpression LockingClauseList?
  | QueryExpressionParens

QueryExpressionWithOptLockingClauses
  = QueryExpression LockingClauseList?

CreateRoutine
  = CREATE (CreateProcedure | CreateFunction | CreateUdf) SEMICOLON?

CreateProcedure
  = DefinerClause? PROCEDURE IfNotExists? ProcedureName OPEN_PAR (ProcedureParameter (COMMA ProcedureParameter)*)? CLOSE_PAR RoutineCreateOption* StoredRoutineBody

RoutineString
  = TextStringLiteral
  | DollarQuotedText

StoredRoutineBody
  = CompoundStatement
  | AS RoutineString

CreateFunction
  = DefinerClause? FUNCTION IfNotExists? FunctionName OPEN_PAR (FunctionParameter (COMMA FunctionParameter)*)? CLOSE_PAR RETURNS TypeWithOptCollate RoutineCreateOption* StoredRoutineBody

CreateUdf
  = AGGREGATE? FUNCTION IfNotExists? UdfName RETURNS (STRING | INT | REAL | DECIMAL) SONAME TextLiteral

RoutineCreateOption
  = RoutineOption
  | NOT? DETERMINISTIC

RoutineAlterOptions
  = RoutineCreateOption+

RoutineOption
  = COMMENT TextLiteral
  | LANGUAGE (SQL | Identifier)
  | NO SQL
  | CONTAINS SQL
  | READS SQL DATA
  | MODIFIES SQL DATA
  | SQL SECURITY (DEFINER | INVOKER)

CreateIndex
  = OnlineOption? GroupCreateIndex1 IndexLockAndAlgorithm?

IndexNameAndType
  = IndexName
  | IndexName? USING IndexType
  | IndexName TYPE IndexType

CreateIndexTarget
  = ON TableRef KeyListWithExpression

CreateLogfileGroup
  = LOGFILE GROUP LogfileGroupName ADD UNDOFILE TextLiteral LogfileGroupOptions?

LogfileGroupOptions
  = LogfileGroupOption (COMMA? LogfileGroupOption)*

LogfileGroupOption
  = TsOptionInitialSize
  | TsOptionUndoRedoBufferSize
  | TsOptionNodegroup
  | TsOptionEngine
  | TsOptionWait
  | TsOptionComment

CreateServer
  = SERVER ServerName FOREIGN DATA WRAPPER TextOrIdentifier ServerOptions

ServerOptions
  = OPTIONS OPEN_PAR ServerOption (COMMA ServerOption)* CLOSE_PAR

ServerOption
  = HOST TextLiteral
  | DATABASE TextLiteral
  | USER TextLiteral
  | PASSWORD TextLiteral
  | SOCKET TextLiteral
  | OWNER TextLiteral
  | PORT UlongNumber

CreateTablespace
  = TABLESPACE TablespaceName TsDataFileName (USE LOGFILE GROUP LogfileGroupRef)? TablespaceOptions?

CreateUndoTablespace
  = UNDO TABLESPACE TablespaceName ADD TsDataFile UndoTableSpaceOptions?

TsDataFile
  = DATAFILE TextLiteral

TablespaceOptions
  = TablespaceOption (COMMA? TablespaceOption)*

TablespaceOption
  = TsOptionInitialSize
  | TsOptionAutoextendSize
  | TsOptionMaxSize
  | TsOptionExtentSize
  | TsOptionNodegroup
  | TsOptionEngine
  | TsOptionWait
  | TsOptionComment
  | TsOptionFileblockSize
  | TsOptionEncryption
  | TsOptionEngineAttribute

TsOptionInitialSize
  = INITIAL_SIZE EQUAL? SizeNumber

TsOptionUndoRedoBufferSize
  = (UNDO_BUFFER_SIZE | REDO_BUFFER_SIZE) EQUAL? SizeNumber

TsOptionAutoextendSize
  = AUTOEXTEND_SIZE EQUAL? SizeNumber

TsOptionMaxSize
  = MAX_SIZE EQUAL? SizeNumber

TsOptionExtentSize
  = EXTENT_SIZE EQUAL? SizeNumber

TsOptionNodegroup
  = NODEGROUP EQUAL? RealUlongNumber

TsOptionEngine
  = STORAGE? ENGINE EQUAL? EngineRef

TsOptionWait
  = (WAIT | NO_WAIT)

TsOptionComment
  = COMMENT EQUAL? TextLiteral

TsOptionFileblockSize
  = FILE_BLOCK_SIZE EQUAL? SizeNumber

TsOptionEncryption
  = ENCRYPTION EQUAL? TextStringLiteral

TsOptionEngineAttribute
  = ENGINE_ATTRIBUTE EQUAL? JsonAttribute

CreateView
  = ViewReplaceOrAlgorithm? DefinerClause? ViewSuid? VIEW ViewName ViewTail

ViewReplaceOrAlgorithm
  = OR REPLACE ViewAlgorithm?
  | ViewAlgorithm

ViewAlgorithm
  = ALGORITHM EQUAL (UNDEFINED | MERGE | TEMPTABLE)

ViewSuid
  = SQL SECURITY (DEFINER | INVOKER)

CreateTrigger
  = DefinerClause? TRIGGER IfNotExists? TriggerName (BEFORE | AFTER) (INSERT | UPDATE | DELETE) ON TableRef FOR EACH ROW TriggerFollowsPrecedesClause? CompoundStatement

TriggerFollowsPrecedesClause
  = (FOLLOWS | PRECEDES) TextOrIdentifier

CreateEvent
  = DefinerClause? EVENT IfNotExists? EventName ON SCHEDULE Schedule (ON COMPLETION NOT? PRESERVE)? GroupCreateEvent1? (COMMENT TextLiteral)? DO CompoundStatement

CreateRole
  = ROLE IfNotExists? RoleList

CreateSpatialReference
  = OR REPLACE SPATIAL REFERENCE SYSTEM RealUlonglongNumber SrsAttribute*
  | SPATIAL REFERENCE SYSTEM IfNotExists? RealUlonglongNumber SrsAttribute*

SrsAttribute
  = NAME TextStringNoLinebreak
  | DEFINITION TextStringNoLinebreak
  | ORGANIZATION TextStringNoLinebreak IDENTIFIED BY RealUlonglongNumber
  | DESCRIPTION TextStringNoLinebreak

DropStatement
  = DROP (DropDatabase | DropEvent | DropFunction | DropProcedure | DropIndex | DropLogfileGroup | DropServer | DropTable | DropTableSpace | DropTrigger | DropView | DropRole | DropSpatialReference | DropUndoTablespace)

DropDatabase
  = DATABASE IfExists? SchemaRef

DropEvent
  = EVENT IfExists? EventRef

DropFunction
  = FUNCTION IfExists? FunctionRef

DropProcedure
  = PROCEDURE IfExists? ProcedureRef

DropIndex
  = OnlineOption? KW_INDEX IndexRef ON TableRef IndexLockAndAlgorithm?

DropLogfileGroup
  = LOGFILE GROUP LogfileGroupRef (DropLogfileGroupOption (COMMA? DropLogfileGroupOption)*)?

DropLogfileGroupOption
  = TsOptionWait
  | TsOptionEngine

DropServer
  = SERVER IfExists? ServerRef

DropTable
  = TEMPORARY? (TABLE | TABLES) IfExists? TableRefList ((RESTRICT | CASCADE))?

DropTableSpace
  = TABLESPACE TablespaceRef (DropLogfileGroupOption (COMMA? DropLogfileGroupOption)*)?

DropTrigger
  = TRIGGER IfExists? TriggerRef

DropView
  = VIEW IfExists? ViewRefList ((RESTRICT | CASCADE))?

DropRole
  = ROLE IfExists? RoleList

DropSpatialReference
  = SPATIAL REFERENCE SYSTEM IfExists? RealUlonglongNumber

DropUndoTablespace
  = UNDO TABLESPACE TablespaceRef UndoTableSpaceOptions?

RenameTableStatement
  = RENAME (TABLE | TABLES) RenamePair (COMMA RenamePair)*

RenamePair
  = TableRef TO TableName

TruncateTableStatement
  = TRUNCATE TABLE? TableRef

ImportStatement
  = IMPORT TABLE FROM TextStringLiteralList

CallStatement
  = CALL ProcedureRef (OPEN_PAR ExprList? CLOSE_PAR)?

DeleteStatement
  = WithClause? DELETE DeleteStatementOption* GroupDeleteStatement2

PartitionDelete
  = PARTITION OPEN_PAR IdentifierList CLOSE_PAR

DeleteStatementOption
  = QUICK
  | LOW_PRIORITY
  | IGNORE

DoStatement
  = DO SelectItemList

HandlerStatement
  = HANDLER GroupHandlerStatement2

HandlerReadOrScan
  = (FIRST | NEXT)
  | Identifier GroupHandlerReadOrScan1

InsertStatement
  = INSERT InsertLockOption? IGNORE? INTO? TableRef UsePartition? GroupInsertStatement1 InsertUpdateList?

InsertLockOption
  = LOW_PRIORITY
  | DELAYED
  | HIGH_PRIORITY

InsertFromConstructor
  = (OPEN_PAR Fields? CLOSE_PAR)? InsertValues

Fields
  = InsertIdentifier (COMMA InsertIdentifier)*

InsertValues
  = (VALUES | VALUE) ValueList

ValueList
  = OPEN_PAR Values? CLOSE_PAR (COMMA OPEN_PAR Values? CLOSE_PAR)*

Values
  = (Expression | DEFAULT) (COMMA (Expression | DEFAULT))*

ValuesReference
  = AS Identifier ColumnInternalRefList?

InsertUpdateList
  = ON DUPLICATE KEY UPDATE UpdateList

DataOrXml
  = DATA
  | XML

LoadDataLock
  = LOW_PRIORITY
  | CONCURRENT

LoadFrom
  = FROM

LoadSourceType
  = INFILE
  | (URL | S3)

SourceOrder
  = IN PRIMARY KEY ORDER

XmlRowsIdentifiedBy
  = ROWS IDENTIFIED BY TextString

LoadDataFileTail
  = (IGNORE IntegerLiteral (LINES | ROWS))? LoadDataFileTargetList? (SET UpdateList)?

LoadDataFileTargetList
  = OPEN_PAR FieldOrVariableList? CLOSE_PAR

LoadAlgorithm
  = ALGORITHM EQUAL BULK

LoadParallel
  = PARALLEL EQUAL IntegerLiteral

LoadMemory
  = MEMORY EQUAL SizeNumber

ReplaceStatement
  = REPLACE ((LOW_PRIORITY | DELAYED))? INTO? TableRef UsePartition? GroupReplaceStatement1

SelectStatement
  = QueryExpression LockingClauseList?
  | SelectStatementWithInto

SelectStatementWithInto
  = OPEN_PAR SelectStatementWithInto CLOSE_PAR
  | QueryExpression IntoClause LockingClauseList?
  | QueryExpression LockingClauseList IntoClause

QueryExpression
  = WithClause? QueryExpressionBody OrderClause? LimitClause?

QueryPrimary
  = QuerySpecification
  | TableValueConstructor
  | ExplicitTable

QuerySpecOption
  = ALL
  | DISTINCT
  | STRAIGHT_JOIN
  | HIGH_PRIORITY
  | SQL_SMALL_RESULT
  | SQL_BIG_RESULT
  | SQL_BUFFER_RESULT
  | SQL_CALC_FOUND_ROWS

LimitClause
  = LIMIT LimitOptions

SimpleLimitClause
  = LIMIT LimitOption

LimitOptions
  = LimitOption ((COMMA | OFFSET) LimitOption)?

LimitOption
  = Identifier
  | (PARAM_MARKER | UnsignedLongLiteral | LongLiteral | IntegerLiteral)

IntoClause
  = INTO GroupIntoClause1

ProcedureAnalyseClause
  = PROCEDURE OPEN_PAR (IntegerLiteral (COMMA IntegerLiteral)?)? CLOSE_PAR

HavingClause
  = HAVING Expression

QualifyClause
  = QUALIFY Expression

WindowClause
  = WINDOW WindowDefinition (COMMA WindowDefinition)*

WindowDefinition
  = WindowName AS WindowSpec

WindowSpec
  = OPEN_PAR WindowSpecDetails CLOSE_PAR

WindowSpecDetails
  = WindowName? (PARTITION BY OrderList)? OrderClause? WindowFrameClause?

WindowFrameClause
  = WindowFrameUnits WindowFrameExtent WindowFrameExclusion?

WindowFrameUnits
  = ROWS
  | RANGE
  | GROUPS

WindowFrameExtent
  = WindowFrameStart
  | WindowFrameBetween

WindowFrameStart
  = UNBOUNDED PRECEDING
  | UlonglongNumber PRECEDING
  | PARAM_MARKER PRECEDING
  | INTERVAL Expression Interval PRECEDING
  | CURRENT ROW

WindowFrameBetween
  = BETWEEN WindowFrameBound AND WindowFrameBound

WindowFrameBound
  = WindowFrameStart
  | UNBOUNDED FOLLOWING
  | UlonglongNumber FOLLOWING
  | PARAM_MARKER FOLLOWING
  | INTERVAL Expression Interval FOLLOWING

WindowFrameExclusion
  = EXCLUDE GroupWindowFrameExclusion1

WithClause
  = WITH RECURSIVE? CommonTableExpression (COMMA CommonTableExpression)*

CommonTableExpression
  = Identifier ColumnInternalRefList? AS Subquery

GroupByClause
  = GROUP BY OrderList OlapOption?
  | GROUP BY (ROLLUP | CUBE) OPEN_PAR GroupList CLOSE_PAR

OlapOption
  = WITH ROLLUP

OrderClause
  = ORDER BY OrderList

Direction
  = ASC
  | DESC

FromClause
  = FROM (DUAL | TableReferenceList)

TableReferenceList
  = TableReference (COMMA TableReference)*

TableValueConstructor
  = VALUES RowValueExplicit (COMMA RowValueExplicit)*

ExplicitTable
  = TABLE TableRef

RowValueExplicit
  = ROW OPEN_PAR Values? CLOSE_PAR

SelectOption
  = QuerySpecOption
  | SQL_NO_CACHE

LockingClauseList
  = LockingClause+

LockingClause
  = FOR LockStrengh (OF TableAliasRefList)? LockedRowAction?
  | LOCK IN SHARE MODE

LockStrengh
  = UPDATE
  | SHARE

LockedRowAction
  = SKIP LOCKED
  | NOWAIT

SelectItemList
  = (SelectItem | MULT) (COMMA SelectItem)*

SelectItem
  = TableWild
  | Expression SelectAlias?

SelectAlias
  = AS? (Identifier | TextStringLiteral)

WhereClause
  = WHERE Expression

JoinedTable
  = InnerJoinType TableReference GroupJoinedTable1?
  | OuterJoinType TableReference GroupJoinedTable2
  | NaturalJoinType TableFactor

NaturalJoinType
  = NATURAL INNER? JOIN
  | NATURAL (LEFT | RIGHT) OUTER? JOIN

InnerJoinType
  = ((INNER | CROSS))? JOIN
  | STRAIGHT_JOIN

OuterJoinType
  = (LEFT | RIGHT) OUTER? JOIN

SingleTable
  = TableRef UsePartition? TableAlias? IndexHintList? TablesampleClause?

SingleTableParens
  = OPEN_PAR (SingleTable | SingleTableParens) CLOSE_PAR

DerivedTable
  = Subquery TableAlias? ColumnInternalRefList?
  | LATERAL Subquery TableAlias? ColumnInternalRefList?

TableFunction
  = JSON_TABLE OPEN_PAR Expression COMMA TextStringLiteral ColumnsClause CLOSE_PAR TableAlias?

ColumnsClause
  = COLUMNS OPEN_PAR JtColumn (COMMA JtColumn)* CLOSE_PAR

JtColumn
  = Identifier FOR ORDINALITY
  | Identifier DataType (Collate)? EXISTS? PATH TextStringLiteral OnEmptyOrErrorJsonTable?
  | NESTED PATH TextStringLiteral ColumnsClause

OnEmptyOrError
  = OnEmpty OnError?
  | OnError

OnEmptyOrErrorJsonTable
  = OnEmptyOrError
  | OnError OnEmpty

OnEmpty
  = JsonOnResponse ON EMPTY

OnError
  = JsonOnResponse ON ERROR

JsonOnResponse
  = ERROR
  | NULL
  | DEFAULT TextStringLiteral

UnionOption
  = DISTINCT
  | ALL

TableAlias
  = ((AS | EQUAL))? Identifier

IndexHint
  = IndexHintType KeyOrIndex IndexHintClause? OPEN_PAR IndexList CLOSE_PAR
  | USE KeyOrIndex IndexHintClause? OPEN_PAR IndexList? CLOSE_PAR

IndexHintType
  = FORCE
  | IGNORE

KeyOrIndex
  = KEY
  | KW_INDEX

ConstraintKeyType
  = PRIMARY KEY
  | UNIQUE KeyOrIndex?

IndexHintClause
  = FOR GroupIndexHintClause1

IndexList
  = IndexListElement (COMMA IndexListElement)*

IndexListElement
  = Identifier
  | PRIMARY

UpdateStatement
  = WithClause? UPDATE LOW_PRIORITY? IGNORE? TableReferenceList SET UpdateList WhereClause? OrderClause? SimpleLimitClause?

TransactionOrLockingStatement
  = TransactionStatement
  | SavepointStatement
  | LockStatement
  | XaStatement

BeginWork
  = BEGIN WORK?

SavepointStatement
  = SAVEPOINT Identifier
  | ROLLBACK WORK? GroupSavepointStatement1
  | RELEASE SAVEPOINT Identifier

LockStatement
  = LOCK (TABLES | TABLE) LockItem (COMMA LockItem)*
  | LOCK INSTANCE FOR BACKUP
  | UNLOCK (TABLES | TABLE | INSTANCE)

LockItem
  = TableRef TableAlias? LockOption

LockOption
  = READ LOCAL?
  | LOW_PRIORITY? WRITE

XaStatement
  = XA GroupXaStatement1

XaConvert
  = CONVERT XID

Xid
  = TextString (COMMA TextString (COMMA UlongNumber)?)?

ReplicationStatement
  = PURGE PurgeOptions
  | ChangeSource
  | RESET ResetOption (COMMA ResetOption)*
  | RESET PERSIST IfExistsIdentifier?
  | StartReplicaStatement
  | StopReplicaStatement
  | ChangeReplication
  | GroupReplication

PurgeOptions
  = (BINARY | MASTER) LOGS GroupPurgeOptions1

ResetOption
  = MasterOrBinaryLogsAndGtids SourceResetOptions?
  | Replica ALL? Channel?

MasterOrBinaryLogsAndGtids
  = MASTER
  | BINARY LOGS AND GTIDS

SourceResetOptions
  = TO RealUlonglongNumber

ChangeReplicationSource
  = MASTER
  | REPLICATION SOURCE

ChangeSource
  = CHANGE ChangeReplicationSource TO SourceDefinitions Channel?

SourceDefinitions
  = SourceDefinition (COMMA SourceDefinition)*

SourceDefinition
  = ChangeReplicationSourceHost EQUAL TextStringNoLinebreak
  | NETWORK_NAMESPACE EQUAL TextStringNoLinebreak
  | ChangeReplicationSourceBind EQUAL TextStringNoLinebreak
  | ChangeReplicationSourceUser EQUAL TextStringNoLinebreak
  | ChangeReplicationSourcePassword EQUAL TextStringNoLinebreak
  | ChangeReplicationSourcePort EQUAL UlongNumber
  | ChangeReplicationSourceConnectRetry EQUAL UlongNumber
  | ChangeReplicationSourceRetryCount EQUAL UlongNumber
  | ChangeReplicationSourceDelay EQUAL UlongNumber
  | ChangeReplicationSourceSSL EQUAL UlongNumber
  | ChangeReplicationSourceSSLCA EQUAL TextStringNoLinebreak
  | ChangeReplicationSourceSSLCApath EQUAL TextStringNoLinebreak
  | ChangeReplicationSourceTLSVersion EQUAL TextStringNoLinebreak
  | ChangeReplicationSourceSSLCert EQUAL TextStringNoLinebreak
  | ChangeReplicationSourceTLSCiphersuites EQUAL SourceTlsCiphersuitesDef
  | ChangeReplicationSourceSSLCipher EQUAL TextStringNoLinebreak
  | ChangeReplicationSourceSSLKey EQUAL TextStringNoLinebreak
  | ChangeReplicationSourceSSLVerifyServerCert EQUAL UlongNumber
  | ChangeReplicationSourceSSLCLR EQUAL TextLiteral
  | ChangeReplicationSourceSSLCLRpath EQUAL TextStringNoLinebreak
  | ChangeReplicationSourcePublicKey EQUAL TextStringNoLinebreak
  | ChangeReplicationSourceGetSourcePublicKey EQUAL UlongNumber
  | ChangeReplicationSourceHeartbeatPeriod EQUAL UlongNumber
  | IGNORE_SERVER_IDS EQUAL ServerIdList
  | ChangeReplicationSourceCompressionAlgorithm EQUAL TextStringLiteral
  | ChangeReplicationSourceZstdCompressionLevel EQUAL UlongNumber
  | ChangeReplicationSourceAutoPosition EQUAL UlongNumber
  | PRIVILEGE_CHECKS_USER EQUAL PrivilegeCheckDef
  | REQUIRE_ROW_FORMAT EQUAL UlongNumber
  | REQUIRE_TABLE_PRIMARY_KEY_CHECK EQUAL TablePrimaryKeyCheckDef
  | SOURCE_CONNECTION_AUTO_FAILOVER EQUAL RealUlongNumber
  | ASSIGN_GTIDS_TO_ANONYMOUS_TRANSACTIONS EQUAL AssignGtidsToAnonymousTransactionsDefinition
  | GTID_ONLY EQUAL RealUlongNumber
  | SourceFileDef

ChangeReplicationSourceAutoPosition
  = MASTER_AUTO_POSITION
  | SOURCE_AUTO_POSITION

ChangeReplicationSourceHost
  = MASTER_HOST
  | SOURCE_HOST

ChangeReplicationSourceBind
  = MASTER_BIND
  | SOURCE_BIND

ChangeReplicationSourceUser
  = MASTER_USER
  | SOURCE_USER

ChangeReplicationSourcePassword
  = MASTER_PASSWORD
  | SOURCE_PASSWORD

ChangeReplicationSourcePort
  = MASTER_PORT
  | SOURCE_PORT

ChangeReplicationSourceConnectRetry
  = MASTER_CONNECT_RETRY
  | SOURCE_CONNECT_RETRY

ChangeReplicationSourceRetryCount
  = MASTER_RETRY_COUNT
  | SOURCE_RETRY_COUNT

ChangeReplicationSourceDelay
  = MASTER_DELAY
  | SOURCE_DELAY

ChangeReplicationSourceSSL
  = MASTER_SSL
  | SOURCE_SSL

ChangeReplicationSourceSSLCA
  = MASTER_SSL_CA
  | SOURCE_SSL_CA

ChangeReplicationSourceSSLCApath
  = MASTER_SSL_CAPATH
  | SOURCE_SSL_CAPATH

ChangeReplicationSourceSSLCipher
  = MASTER_SSL_CIPHER
  | SOURCE_SSL_CIPHER

ChangeReplicationSourceSSLCLR
  = MASTER_SSL_CRL
  | SOURCE_SSL_CRL

