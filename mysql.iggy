  | SUBCLASS_ORIGIN
  | CONSTRAINT_CATALOG
  | CONSTRAINT_SCHEMA
  | CONSTRAINT_NAME
  | CATALOG_NAME
  | SCHEMA_NAME
  | TABLE_NAME
  | COLUMN_NAME
  | CURSOR_NAME
  | MESSAGE_TEXT
  | MYSQL_ERRNO

SignalStatement
  = SIGNAL (Identifier | Sqlstate) (SET SignalInformationItem (COMMA SignalInformationItem)*)?

ResignalStatement
  = RESIGNAL ((Identifier | Sqlstate))? (SET SignalInformationItem (COMMA SignalInformationItem)*)?

SignalInformationItem
  = SignalInformationItemName EQUAL SignalAllowedExpr

CursorOpen
  = OPEN Identifier

CursorClose
  = CLOSE Identifier

CursorFetch
  = FETCH (NEXT? FROM)? Identifier INTO IdentifierList

Schedule
  = AT Expression
  | EVERY Expression Interval (STARTS Expression)? (ENDS Expression)?

ColumnDefinition
  = ColumnName FieldDefinition CheckOrReferences?

CheckOrReferences
  = References

CheckConstraint
  = CHECK ExprWithParentheses

ConstraintEnforcement
  = NOT? ENFORCED

TableConstraintDef
  = (KEY | KW_INDEX) IndexNameAndType? KeyListWithExpression IndexOption*
  | FULLTEXT KeyOrIndex? IndexName? KeyListWithExpression FulltextIndexOption*
  | SPATIAL KeyOrIndex? IndexName? KeyListWithExpression SpatialIndexOption*
  | ConstraintName? GroupTableConstraintDef2

ConstraintName
  = CONSTRAINT Identifier?

FieldDefinition
  = DataType GroupFieldDefinition1

ColumnAttribute
  = NOT? NullLiteral
  | NOT SECONDARY
  | DEFAULT (NowOrSignedLiteral | ExprWithParentheses)
  | GroupColumnAttribute1
  | AUTO_INCREMENT
  | SERIAL DEFAULT VALUE
  | PRIMARY? KEY
  | UNIQUE KEY
  | UNIQUE !>>> KEY
  | COMMENT TextLiteral
  | Collate
  | COLUMN_FORMAT ColumnFormat
  | STORAGE StorageMedia
  | SRID RealUlonglongNumber
  | ConstraintName? CheckConstraint ConstraintEnforcement*
  | ENGINE_ATTRIBUTE EQUAL? JsonAttribute
  | SECONDARY_ENGINE_ATTRIBUTE EQUAL? JsonAttribute
  | Visibility

ColumnFormat
  = FIXED
  | DYNAMIC
  | DEFAULT

StorageMedia
  = DISK
  | MEMORY
  | DEFAULT

Now
  = GroupNow1

NowOrSignedLiteral
  = Now
  | SignedLiteralOrNull

GcolAttribute
  = UNIQUE KEY
  | UNIQUE !>>> KEY
  | COMMENT TextString
  | NotRule? NULL
  | PRIMARY? KEY

References
  = REFERENCES TableRef IdentifierListWithParentheses? (MATCH (FULL | PARTIAL | SIMPLE))? GroupReferences1?

DeleteOption
  = (RESTRICT | CASCADE)
  | SET NullLiteral
  | SET DEFAULT
  | NO ACTION

KeyList
  = OPEN_PAR KeyPart (COMMA KeyPart)* CLOSE_PAR

KeyPart
  = Identifier FieldLength? Direction?

KeyListWithExpression
  = OPEN_PAR KeyPartOrExpression (COMMA KeyPartOrExpression)* CLOSE_PAR

KeyPartOrExpression
  = KeyPart
  | ExprWithParentheses Direction?

IndexType
  = (BTREE | RTREE | HASH)

IndexOption
  = CommonIndexOption
  | IndexTypeClause

CommonIndexOption
  = KEY_BLOCK_SIZE EQUAL? UlongNumber
