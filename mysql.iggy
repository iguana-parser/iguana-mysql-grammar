@Regex
VAR_SAMP_CALL_OPEN = ([vV] [aA] [rR] "_" [sS] [aA] [mM] [pP] "(")

@Regex
ContextualFunctionWord = FunctionOnlyWord | ContextualKeywordWord

// Function spellings admitted as identifiers even before an adjacent '('.
@Regex
ContextualKeywordWord
  = [aA] [dD] [dD] [dD] [aA] [tT] [eE]
  | [sS] [eE] [sS] [sS] [iI] [oO] [nN] "_" [uU] [sS] [eE] [rR]
  | [sS] [uU] [bB] [dD] [aA] [tT] [eE]
  | [sS] [yY] [sS] [tT] [eE] [mM] "_" [uU] [sS] [eE] [rR]

@Regex
CharsetIntroducerWord = "_" [aA] [rR] [mM] [sS] [cC] [iI] [iI] "8"
  | "_" [aA] [sS] [cC] [iI] [iI]
  | "_" [bB] [iI] [gG] "5"
  | "_" [bB] [iI] [nN] [aA] [rR] [yY]
  | "_" [cC] [pP] "1" "2" "5" "0"
  | "_" [cC] [pP] "1" "2" "5" "1"
  | "_" [cC] [pP] "1" "2" "5" "6"
