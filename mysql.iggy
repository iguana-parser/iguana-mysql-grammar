  | [uU] [nN] [iI] [nN] [sS] [tT] [aA] [lL] [lL]
  | [xX] [aA]

// Admitted as an identifier, label or SET variable, but not a role.
@Regex
Ambiguous3Word
  = [eE] [vV] [eE] [nN] [tT]
  | [fF] [iI] [lL] [eE]
  | [nN] [oO] [nN] [eE]
  | [pP] [rR] [oO] [cC] [eE] [sS] [sS]
  | [pP] [rR] [oO] [xX] [yY]
  | [rR] [eE] [lL] [oO] [aA] [dD]
  | [rR] [eE] [pP] [lL] [iI] [cC] [aA] [tT] [iI] [oO] [nN]
  | [rR] [eE] [sS] [oO] [uU] [rR] [cC] [eE]
  | [sS] [uU] [pP] [eE] [rR]

// Scope keywords: admitted as identifiers, roles and labels, but not SET variables.
@Regex
Ambiguous4Word
  = [gG] [lL] [oO] [bB] [aA] [lL]
  | [lL] [oO] [cC] [aA] [lL]
  | [pP] [eE] [rR] [sS] [iI] [sS] [tT]
  | [pP] [eE] [rR] [sS] [iI] [sS] [tT] "_" [oO] [nN] [lL] [yY]
  | [sS] [eE] [sS] [sS] [iI] [oO] [nN]

// Admitted as identifiers unless '(' follows immediately.
@Regex
FunctionOnlyWord
  = [bB] [iI] [tT] "_" [aA] [nN] [dD]
  | [bB] [iI] [tT] "_" [oO] [rR]
  | [bB] [iI] [tT] "_" [xX] [oO] [rR]
  | [cC] [aA] [sS] [tT]
  | [cC] [oO] [uU] [nN] [tT]
  | [cC] [uU] [rR] [dD] [aA] [tT] [eE]
  | [cC] [uU] [rR] [rR] [eE] [nN] [tT] "_" [dD] [aA] [tT] [eE]
  | [cC] [uU] [rR] [rR] [eE] [nN] [tT] "_" [tT] [iI] [mM] [eE]
  | [cC] [uU] [rR] [tT] [iI] [mM] [eE]
  | [dD] [aA] [tT] [eE] "_" [aA] [dD] [dD]
  | [dD] [aA] [tT] [eE] "_" [sS] [uU] [bB]
  | [eE] [xX] [tT] [rR] [aA] [cC] [tT]
  | [gG] [rR] [oO] [uU] [pP] "_" [cC] [oO] [nN] [cC] [aA] [tT]
  | [mM] [aA] [xX]
  | [mM] [iI] [dD]
  | [mM] [iI] [nN]
  | [nN] [oO] [wW]
  | [pP] [oO] [sS] [iI] [tT] [iI] [oO] [nN]
  | [sS] [tT] [dD]
  | [sS] [tT] [dD] [dD] [eE] [vV]
  | [sS] [tT] [dD] [dD] [eE] [vV] "_" [pP] [oO] [pP]
  | [sS] [tT] [dD] [dD] [eE] [vV] "_" [sS] [aA] [mM] [pP]
  | [sS] [uU] [bB] [sS] [tT] [rR]
  | [sS] [uU] [bB] [sS] [tT] [rR] [iI] [nN] [gG]
  | [sS] [uU] [mM]
  | [sS] [yY] [sS] [dD] [aA] [tT] [eE]
  | [tT] [rR] [iI] [mM]
  | [vV] [aA] [rR] "_" [pP] [oO] [pP]
  | [vV] [aA] [rR] "_" [sS] [aA] [mM] [pP]
  | [vV] [aA] [rR] [iI] [aA] [nN] [cC] [eE]

// All unquoted identifier tokens exclude the same literal shapes.
@Regex
IdentifierLiteralShape = FloatPattern | HexPattern | BinaryPattern | CharsetIntroducerWord
