  | "_" [cC] [pP] "8" "5" "2"
  | "_" [cC] [pP] "8" "6" "6"
  | "_" [cC] [pP] "9" "3" "2"
  | "_" [dD] [eE] [cC] "8"
  | "_" [eE] [uU] [cC] [jJ] [pP] [mM] [sS]
  | "_" [eE] [uU] [cC] [kK] [rR]
  | "_" [gG] [bB] "1" "8" "0" "3" "0"
  | "_" [gG] [bB] "2" "3" "1" "2"
  | "_" [gG] [bB] [kK]
  | "_" [gG] [eE] [oO] [sS] [tT] [dD] "8"
  | "_" [gG] [rR] [eE] [eE] [kK]
  | "_" [hH] [eE] [bB] [rR] [eE] [wW]
  | "_" [hH] [pP] "8"
  | "_" [kK] [eE] [yY] [bB] [cC] [sS] "2"
  | "_" [kK] [oO] [iI] "8" [rR]
  | "_" [kK] [oO] [iI] "8" [uU]
  | "_" [lL] [aA] [tT] [iI] [nN] "1"
  | "_" [lL] [aA] [tT] [iI] [nN] "2"
  | "_" [lL] [aA] [tT] [iI] [nN] "5"
  | "_" [lL] [aA] [tT] [iI] [nN] "7"
  | "_" [mM] [aA] [cC] [cC] [eE]
  | "_" [mM] [aA] [cC] [rR] [oO] [mM] [aA] [nN]
  | "_" [sS] [jJ] [iI] [sS]
  | "_" [sS] [wW] [eE] "7"
  | "_" [tT] [iI] [sS] "6" "2" "0"
  | "_" [uU] [cC] [sS] "2"
  | "_" [uU] [jJ] [iI] [sS]
  | "_" [uU] [tT] [fF] "1" "6"
  | "_" [uU] [tT] [fF] "1" "6" [lL] [eE]
  | "_" [uU] [tT] [fF] "3" "2"
  | "_" [uU] [tT] [fF] "8" [mM] [bB] "3"
  | "_" [uU] [tT] [fF] "8" [mM] [bB] "4"
  | "_" [uU] [tT] [fF] "8"

// Derive identifier exclusions from the shared classes, rather than keeping
// an independently copied keyword list for each context.
@Regex
UnquotedIdentifierRejectedKeywords = ReservedWord | UnambiguousKeywordWord | Ambiguous1Word | Ambiguous2Word | Ambiguous3Word | Ambiguous4Word

@Regex
UnquotedIdentifierWordToken = IdentifierWord \ UnquotedIdentifierRejectedKeywords \ IdentifierLiteralShape !>> IdentifierPart

@Regex
IdentifierRejectedKeywords = ReservedWord

// Check at the beginning of the word, before any characters are consumed.
// Function-only names cannot precede an adjacent '('; n/x/b commit to a
// string/hex/bit token on any adjacent quote, even for invalid contents.
// An adjacent signed exponent makes a number rather than an identifier.
@Regex
IdentifierInvalidStart = FunctionOnlyWord OpenParen
  | LiteralIntroducer SingleQuote
  | ExponentIdentifierWord SignedExponent

@Regex
IdentifierWordToken = IdentifierWord \ IdentifierRejectedKeywords \ IdentifierLiteralShape !>> IdentifierPart

@Regex
LabelIdentifierRejectedKeywords = ReservedWord | Ambiguous1Word | Ambiguous2Word

@Regex
LabelIdentifierWordToken = IdentifierWord \ LabelIdentifierRejectedKeywords \ IdentifierLiteralShape !>> IdentifierPart

@Regex
RoleIdentifierRejectedKeywords = ReservedWord | Ambiguous1Word | Ambiguous3Word

@Regex
RoleIdentifierWordToken = IdentifierWord \ RoleIdentifierRejectedKeywords \ IdentifierLiteralShape !>> IdentifierPart

@Regex
LValueIdentifierRejectedKeywords = ReservedWord | Ambiguous4Word

@Regex
LValueIdentifierWordToken = IdentifierWord \ LValueIdentifierRejectedKeywords \ IdentifierLiteralShape !>> IdentifierPart

// The empty guard lets !>> inspect the word's starting position. No layout
// is inserted between this guard, its restriction and the identifier token.
@NoLayout
IdentifierContextGuard = ()

// Keyword classification is defined once in these eight disjoint classes.
// Keep each spelling in exactly one class; the rejection rules above derive
// their context-specific sets from these classes. Keyword terminals retain
// their own spellings and boundaries. scripts/check_keyword_classes.py checks
// that these copies agree, including aliases and function-call tokens.
//
// Reserved in every unquoted identifier context.
