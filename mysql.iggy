IdentifiedWithPluginAsAuth
  = IDENTIFIED WITH TextOrIdentifier AS TextStringHash

IdentifiedWithPluginByPassword
  = IDENTIFIED WITH TextOrIdentifier BY TextStringLiteral

IdentifiedWithPluginByRandomPassword
