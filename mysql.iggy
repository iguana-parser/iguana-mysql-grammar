@NoLayout
LValueIdentifier
  = IdentifierContextGuard !>> IdentifierInvalidStart LValueIdentifierWordToken
  | BacktickIdentifier

RoleIdentifierOrText
  = RoleIdentifier
  | TextStringLiteral

