@Regex
SingleQuotedText = "'" ("''" | "\\" AnyCharacter | !['\\])* "'"

@Regex
DoubleQuotedText = "\"" ("\"\"" | "\\" AnyCharacter | !["\\])* "\""

@Regex
QuotedText = SingleQuotedText | DoubleQuotedText

@Regex
AnyCharacter = ![\n] | [\n]

@Regex
