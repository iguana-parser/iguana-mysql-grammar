LOG = ([lL] [oO] [gG]) !>> IdentifierPart

@Regex
GTIDS = ([gG] [tT] [iI] [dD] [sS]) !>> IdentifierPart

@Regex
PARALLEL = ([pP] [aA] [rR] [aA] [lL] [lL] [eE] [lL]) !>> IdentifierPart

@Regex
S3 = ([sS] "3") !>> IdentifierPart

@Regex
QUALIFY = ([qQ] [uU] [aA] [lL] [iI] [fF] [yY]) !>> IdentifierPart

@Regex
AUTO = ([aA] [uU] [tT] [oO]) !>> IdentifierPart

@Regex
MANUAL = ([mM] [aA] [nN] [uU] [aA] [lL]) !>> IdentifierPart

@Regex
BERNOULLI = ([bB] [eE] [rR] [nN] [oO] [uU] [lL] [lL] [iI]) !>> IdentifierPart

@Regex
TABLESAMPLE = ([tT] [aA] [bB] [lL] [eE] [sS] [aA] [mM] [pP] [lL] [eE]) !>> IdentifierPart

