  | Visibility
  | ENGINE_ATTRIBUTE EQUAL? JsonAttribute
  | SECONDARY_ENGINE_ATTRIBUTE EQUAL? JsonAttribute

Visibility
  = VISIBLE
  | INVISIBLE

IndexTypeClause
  = (USING | TYPE) IndexType

FulltextIndexOption
  = CommonIndexOption
  | WITH PARSER Identifier

SpatialIndexOption
  = CommonIndexOption

DataTypeDefinition
  = DataType

DataType
  = (INT | TINYINT | SMALLINT | MEDIUMINT | BIGINT) FieldLength? FieldOptions?
  | GroupDataType1 Precision? FieldOptions?
  | (FLOAT | DECIMAL | NUMERIC | FIXED) FloatOptions? FieldOptions?
  | BIT FieldLength?
  | (BOOL | BOOLEAN)
  | CHAR FieldLength? CharsetWithOptBinary?
  | Nchar FieldLength? BINARY?
  | BINARY FieldLength?
  | GroupDataType2 FieldLength CharsetWithOptBinary?
  | GroupDataType3 FieldLength BINARY?
  | VARBINARY FieldLength
  | YEAR YearFieldLength? FieldOptions?
  | DATE
  | TIME TypeDatetimePrecision?
  | TIMESTAMP TypeDatetimePrecision?
  | DATETIME TypeDatetimePrecision?
  | TINYBLOB
  | BLOB FieldLength?
  | (MEDIUMBLOB | LONGBLOB)
  | LONG VARBINARY
  | LONG GroupDataType4? CharsetWithOptBinary?
  | TINYTEXT CharsetWithOptBinary?
  | TEXT FieldLength? CharsetWithOptBinary?
  | MEDIUMTEXT CharsetWithOptBinary?
  | LONGTEXT CharsetWithOptBinary?
  | ENUM StringList CharsetWithOptBinary?
  | SET StringList CharsetWithOptBinary?
  | SERIAL
  | JSON
  | (GEOMETRY | GEOMETRYCOLLECTION | POINT | MULTIPOINT | LINESTRING | MULTILINESTRING | POLYGON | MULTIPOLYGON)

Nchar
  = NCHAR
  | NATIONAL CHAR

RealType
  = REAL
  | DOUBLE PRECISION?

FieldOptions
  = ((SIGNED | UNSIGNED | ZEROFILL))+

CharsetWithOptBinary
  = Ascii
  | Unicode
  | BYTE
  | Charset CharsetName BINARY?
  | BINARY (Charset CharsetName)?

Ascii
  = ASCII BINARY?
  | BINARY ASCII

Unicode
  = UNICODE BINARY?
  | BINARY UNICODE

TypeDatetimePrecision
  = OPEN_PAR IntegerLiteral CLOSE_PAR

FunctionDatetimePrecision
  = ()
  | Parentheses
  | OPEN_PAR IntegerLiteral CLOSE_PAR

CharsetName
  = TextOrIdentifier
  | BINARY

CollationName
  = TextOrIdentifier
  | BINARY

CreateTableOptions
  = CreateTableOption (COMMA? CreateTableOption)*

CreateTableOptionsEtc
  = CreateTableOptions CreatePartitioningEtc?
  | CreatePartitioningEtc

CreatePartitioningEtc
  = PartitionClause DuplicateAsQe?
  | DuplicateAsQe

CreateTableOptionsSpaceSeparated
  = CreateTableOption+

CreateTableOption
  = ENGINE EQUAL? EngineRef
  | SECONDARY_ENGINE Equal? (NULL | TextOrIdentifier)
  | MAX_ROWS EQUAL? UlonglongNumber
  | MIN_ROWS EQUAL? UlonglongNumber
  | AVG_ROW_LENGTH EQUAL? UlonglongNumber
  | PASSWORD EQUAL? TextStringLiteral
  | COMMENT EQUAL? TextStringLiteral
  | COMPRESSION EQUAL? TextString
  | ENCRYPTION EQUAL? TextString
  | AUTO_INCREMENT EQUAL? UlonglongNumber
  | PACK_KEYS EQUAL? TernaryOption
  | (STATS_AUTO_RECALC | STATS_PERSISTENT | STATS_SAMPLE_PAGES) EQUAL? TernaryOption
  | (CHECKSUM | TABLE_CHECKSUM) EQUAL? UlongNumber
  | DELAY_KEY_WRITE EQUAL? UlongNumber
  | ROW_FORMAT EQUAL? (DEFAULT | DYNAMIC | FIXED | COMPRESSED | REDUNDANT | COMPACT)
  | UNION EQUAL? OPEN_PAR TableRefList CLOSE_PAR
  | DefaultCharset
  | DefaultCollation
  | INSERT_METHOD EQUAL? (NO | FIRST | LAST)
  | DATA DIRECTORY EQUAL? TextString
  | KW_INDEX DIRECTORY EQUAL? TextString
  | TABLESPACE EQUAL? Identifier
  | STORAGE (DISK | MEMORY)
  | CONNECTION EQUAL? TextString
  | KEY_BLOCK_SIZE EQUAL? UlonglongNumber
  | START TRANSACTION
  | ENGINE_ATTRIBUTE EQUAL? JsonAttribute
  | SECONDARY_ENGINE_ATTRIBUTE EQUAL? JsonAttribute
  | TsOptionAutoextendSize

TernaryOption
  = UlongNumber
  | DEFAULT

DefaultCollation
  = DEFAULT? COLLATE EQUAL? CollationName

DefaultEncryption
  = DEFAULT? ENCRYPTION EQUAL? TextStringLiteral

DefaultCharset
  = DEFAULT? Charset EQUAL? CharsetName

PartitionClause
  = PARTITION BY PartitionTypeDef (PARTITIONS RealUlongNumber)? SubPartitions? PartitionDefinitions?

PartitionTypeDef
  = LINEAR? KEY PartitionKeyAlgorithm? OPEN_PAR IdentifierList? CLOSE_PAR
  | LINEAR? HASH OPEN_PAR BitExpression CLOSE_PAR
  | (RANGE | LIST) GroupPartitionTypeDef1

SubPartitions
  = SUBPARTITION BY LINEAR? GroupSubPartitions1 (SUBPARTITIONS RealUlongNumber)?

PartitionKeyAlgorithm
  = ALGORITHM EQUAL RealUlongNumber

PartitionDefinitions
  = OPEN_PAR PartitionDefinition (COMMA PartitionDefinition)* CLOSE_PAR

PartitionDefinition
  = PARTITION Identifier GroupPartitionDefinition1? PartitionOption* (OPEN_PAR SubpartitionDefinition (COMMA SubpartitionDefinition)* CLOSE_PAR)?

PartitionValuesIn
  = PartitionValueItemListParen
  | OPEN_PAR PartitionValueItemListParen (COMMA PartitionValueItemListParen)* CLOSE_PAR

PartitionOption
  = TABLESPACE EQUAL? Identifier
  | STORAGE? ENGINE EQUAL? EngineRef
  | NODEGROUP EQUAL? RealUlongNumber
  | (MAX_ROWS | MIN_ROWS) EQUAL? RealUlongNumber
  | (DATA | KW_INDEX) DIRECTORY EQUAL? TextLiteral
  | COMMENT EQUAL? TextLiteral

SubpartitionDefinition
  = SUBPARTITION TextOrIdentifier PartitionOption*

PartitionValueItemListParen
  = OPEN_PAR PartitionValueItem (COMMA PartitionValueItem)* CLOSE_PAR

PartitionValueItem
  = BitExpression
  | MAXVALUE

DefinerClause
  = DEFINER EQUAL User

IfExists
  = IF EXISTS

IfExistsIdentifier
  = IfExists? PersistedVariableIdentifier

IfNotExists
  = IF NotRule EXISTS

IgnoreUnknownUser
  = IGNORE UNKNOWN USER

ProcedureParameter
  = ((IN | OUT | INOUT))? FunctionParameter

FunctionParameter
  = ParameterName TypeWithOptCollate

Collate
  = COLLATE CollationName

TypeWithOptCollate
  = DataType Collate?

SchemaIdentifierPair
  = OPEN_PAR SchemaRef COMMA SchemaRef CLOSE_PAR

ViewRefList
  = ViewRef (COMMA ViewRef)*

UpdateList
  = UpdateElement (COMMA UpdateElement)*

UpdateElement
  = ColumnRef EQUAL (Expression | DEFAULT)

CharsetClause
  = Charset CharsetName

FieldsClause
  = COLUMNS FieldTerm+

FieldTerm
  = TERMINATED BY TextString
  | OPTIONALLY? ENCLOSED BY TextString
  | ESCAPED BY TextString

LinesClause
