LikeClause
  = LIKE TextStringLiteral

LikeOrWhere
  = LikeClause
  | WhereClause

OnlineOption
  = ONLINE
  | OFFLINE

NoWriteToBinLog
  = LOCAL
  | NO_WRITE_TO_BINLOG

UsePartition
