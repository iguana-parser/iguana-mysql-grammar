@Regex
GTID_ONLY = ([gG] [tT] [iI] [dD] "_" [oO] [nN] [lL] [yY]) !>> IdentifierPart

@Regex
INTERSECT = ([iI] [nN] [tT] [eE] [rR] [sS] [eE] [cC] [tT]) !>> IdentifierPart

@Regex
BULK = ([bB] [uU] [lL] [kK]) !>> IdentifierPart

@Regex
URL = ([uU] [rR] [lL]) !>> IdentifierPart

@Regex
GENERATE = ([gG] [eE] [nN] [eE] [rR] [aA] [tT] [eE]) !>> IdentifierPart

